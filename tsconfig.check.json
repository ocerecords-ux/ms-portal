{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["stubs/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
