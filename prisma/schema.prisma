// MS Portal - datovy model
// Klicova zasada: KAZDY dotaz na Order/Project v aplikacnim kodu je filtrovan
// podle companyId odvozeneho ze session (nikdy z parametru pozadavku).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Popisky pro lidi viz src/lib/roles.ts (ROLE_LABELS) - napr. ADMIN se v
// adminu zobrazuje jako "Zuzo-labuzo". Klicove hodnoty enumu zustavaji
// zpetne kompatibilni (existujici ucty, middleware, adminGuard kontroluji
// primo 'ADMIN'), pribyvaji jen nove role pro klienty a interni tym.
//
// DODAVATEL byla puvodne role Uzivatele, od 5. 9. 2026 (upresneni zadani) se
// ale dodavatele vedou jako Firmy (viz CompanyType.DODAVATEL nize) - v dobe
// zmeny neexistovaly zadne ucty s touto roli, enum hodnota je proto smazana
// rovnou bez migrace dat.
enum Role {
  CLIENT   // Klient - uzivatel klientske firmy
  HEREC    // Herec
  ADMIN    // Zuzo-labuzo - rozsirena prava jako admin
  ZVUKAR   // Zvukar (interni, do budoucna omezeny vyber projektu)
  PRODUKCE // Produkce (interni)
  // Ucet, za kterym nestoji clovek (zadani 12. 9. 2026) - dnes Bruno.
  // Zamerne NENI mezi internimi rolemi: robot ma vystupovat v seznamech
  // a psat do chatu, ale nema videt projekty, doklady ani cokoliv dalsiho,
  // co portal otevira lidem z tymu.
  ROBOT
  // Počítač u obrazovky ve studiu (zadání 22. 9. 2026: „vytvořil bych pro
  // každé studio účet, kterým se přihlásím v Chromu na počítači, který bude
  // napojený na ten monitor"). Po přihlášení vidí jen tabuli svého studia.
  TABULE
}

// Typ firmy na strance /admin (zadani 5. 9. 2026): Firmy uz nejsou jen
// klienti, ale i dodavatele Mediaspace (produkcni firmy, studia apod.) -
// stejny model Company, jen jine udaje (viz pole nize) a jina zalozka.
enum CompanyType {
  KLIENT
  DODAVATEL
}

enum OrderStatus {
  NEW         // nova
  CONFIRMED   // potvrzena
  IN_PROGRESS // v realizaci
  DONE        // hotovo
  CANCELLED   // zrusena
}

// Druh objednavky (zadani 12. 9. 2026) - klient poptavajici audioknihy vidi
// jinou objednavku (normostrany, cena, herec) nez klient poptavajici reklamy
// (zatim jen zakladni pole, zbytek se upresni pozdeji - viz AdOrderForm.tsx).
// Vychozi AUDIOBOOK, aby stavajici objednavky zustaly beze zmeny.
enum OrderKind {
  AUDIOBOOK
  AD
}

enum CaflouSyncStatus {
  SKIPPED // Caflou zatim neni napojene (chybi API klic)
  PENDING // ceka na zalozeni projektu v Caflou
  OK      // projekt v Caflou uspesne zalozen
  ERROR   // zalozeni se nezdarilo, potreba rucni zasah v adminu
}

model Company {
  id              String      @id @default(cuid())
  code            String?     @unique // verejne ID zobrazovane v adminu, napr. "MSF0001" - viz lib/codes.ts
  type            CompanyType @default(KLIENT)
  name            String

  // --- Klient (type = KLIENT) ---
  ratePerPage    Int?      // predbezna sazba za 1 normostranu, v Kc - jen u klientu
  caflouCompanyId String?   // ID firmy/kontaktu v Caflou - podle nej se z Caflou API tahaji projekty teto firmy
  driveFolderUrl String?   // odkaz na slozku klienta na Google Disku (prirazuje admin rucne)

  // Druh zakazek klienta (zadani 12. 9. 2026) - podle techto dvou priznaku
  // se klientovi na strance /objednavka zobrazi jen prislusny typ objednavky
  // (klient poptavajici jen reklamu nevidi objednavku audioknihy a naopak;
  // ma-li klient oboje, muze si typ prepnout). dealsAudiobooks vychozi true,
  // aby vsem stavajicim klientum (pred timto zadanim) zustalo puvodni
  // chovani beze zmeny.
  dealsAudiobooks Boolean  @default(true)
  dealsAds        Boolean  @default(false)

  /// Audioknihy NA KLIC (zadani 14. 9. 2026). U techto firem neplatime jen
  /// nataceni a strih - platime i herce a obcas jednorazove veci jako
  /// preposlech nebo upravu textu.
  ///
  /// Rozpocet na vyrobu (nataceni + strih + bonus) tim ZUSTAVA NEDOTCENY;
  /// tyhle polozky se vedou vedle nej a scitaji se az v celkovem rozpoctu,
  /// kde je videt zisk z knihy. Viz ProjectBudget.tsx.
  audioknihyNaKlic Boolean @default(false)

  /// CENU NAVRHUJE KLIENT (zadani 23. 9. 2026: "u Albatrosu bych dal pryc
  /// vypocet ceny z normostran. Jen tam nechal pole NS a cenu, ale nic
  /// nepocital. Oni totiz cenu navrhuji sami.").
  ///
  /// U takove firmy se v objednavce audioknihy cena NEPOCITA ze sazby za
  /// normostranu - klient ji vyplni sam a sazba za normostranu nemusi byt
  /// vubec nastavena. Pole "Pocet normostran" zustava.
  cenuUrcujeKlient Boolean @default(false)

  // --- Dodavatel (type = DODAVATEL) - fakturacni/kontaktni udaje, zadani 5. 9. 2026 ---
  contactName    String?   // kontaktni osoba
  /// Posílat faktury i klientovi projektu (zadání 13. 9. 2026). Na kontaktní
  /// e-mail firmy chodí faktura vždycky - tam bývá účetní odběratele. Tohle
  /// k tomu přidá člověka, který má u nich konkrétní projekt na starost;
  /// portál ho vezme z projektu, ke kterému je faktura navázaná.
  fakturyKlientovi Boolean @default(false)
  contactEmail   String?
  contactPhone   String?
  ic             String?
  dic            String?
  vatPayer       Boolean   @default(false) // platce DPH
  bankAccount    String?
  address        String?

  // --- Fakturacni udaje (zadani 6. 9. 2026) - nove je vedeme u VSECH firem,
  // nejen u dodavatelu: karta klienta ma obsahovat IC, DIC, platce DPH a
  // kompletni adresu. Puvodni jednoradkove pole `address` zustava kvuli
  // starym zaznamum dodavatelu.
  addressStreet  String?   // ulice a cislo popisne
  addressCity    String?
  addressZip     String?
  addressCountry String?   @default("CZ") // ISO kod zeme, vychozi Ceska republika

  // Doba splatnosti ve dnech - predvyplni se pri vystavovani faktury.
  paymentTermDays Int?     @default(14)

  /// Komu z nas chodi zpravy o stavu projektu teto firmy (zadani 10. 9. 2026:
  /// "chtel bych u pridavani notifikaci mit jeste i moznosti, na koho to pujde
  /// interne od nas"). Ukladaji se e-maily, ne ID uctu - nekdo z prijemcu
  /// nemusi mit v portalu ucet (napr. spolecna adresa fakturace).
  /// Prazdne = vychozi dvojice z lib/notifikaceFirmy.ts.
  interniPrijemci String[] @default([])

  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users    User[]
  /// Herci, kteri jsou touhle firmou-dodavatelem (zadani 16. 9. 2026).
  herciDodavatele User[] @relation("HerecDodavatel")
  projekty ProjectMeta[] @relation("ProjektFirma")
  notifikace NotifikaceFirmy[]
  orders    Order[]
  projects  Project[]
  offers    Offer[]
  invoices  Invoice[]
  expenses  Expense[]
  contracts Contract[]
  recordingRequests RecordingRequest[]
  rodneListy RodnyList[]
  /// Zadosti o udaje, ktere se tykaji teto firmy.
  pozvankyUdaju PozvankaUdaju[] @relation("PozvankaUdajuFirma")
}

model User {
  id           String    @id @default(cuid())
  code         String?   @unique // verejne ID zobrazovane v adminu, napr. "MSK0001" - viz lib/codes.ts
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  role         Role      @default(CLIENT)
  companyId    String?   // null pro interni ucty (ADMIN/ZVUKAR/PRODUKCE) a pro herce (samostatna jednotka bez firmy)
  company      Company?  @relation(fields: [companyId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // --- Mediaspace (interni role ADMIN/ZVUKAR/PRODUKCE) - zadani 5. 9. 2026 ---
  birthDate    DateTime? // datum narozeni
  photoUrl     String?   // fotka
  // Fotka je v databazi jako data: URL a ma i 70 kB. Seznamy (chat, prehled
  // projektu) potrebuji vedet jen to, JESTLI fotka je - adresu obrazku slozi
  // z id uzivatele. Bez tohoto priznaku tahalo kazde doptani chatu z databaze
  // fotky vsech clenu vsech konverzaci a Supabase to pocital jako odchozi
  // prenos (12. 9. 2026: organizace prekrocila kvotu egressu).
  maFotku      Boolean   @default(false)

  // Hodinova sazba zvukare v Kc (zadani 6. 9. 2026) - z ni se pocitaji vykazy
  // prace. Vychozi 250 Kc; u ostatnich roli se nepouziva.
  hourlyRate   Int?      @default(250)

  /// Smi byt manazerem projektu (zadani 10. 9. 2026: "manazera projektu bych
  /// dal na vyber jen me nebo Karolinu"). Zamerne priznak na uctu, ne seznam
  /// jmen v kodu - lidi se meni a kod by o tom nevedel.
  /// Dokud neni oznaceny NIKDO, nabizeji se vsechny interni ucty - jinak by
  /// po nasazeni zustala nabidka prazdna a projekt by nesel zalozit.
  manazerProjektu Boolean @default(false)

  /// Podepisuje za Mediaspace smlouvy (zadani 15. 9. 2026: „ve chvili, kdy
  /// posilame smlouvu k podpisu, je z nasi strany uz za Karolinu podepsana").
  /// Kdo to ma zaskrtnute, toho podpis se ke smlouve pripoji sam v okamziku
  /// odeslani - druha strana uz dostava dokument podepsany od nas.
  smlouvyPodepisuje Boolean @default(false)

  /// Vlastni podpis na smlouvy - PNG v data URL, ulozeny v Mem uctu.
  /// Kdyz chybi, podepisuje se jmenem (psany podpis), ne obrazkem.
  podpisSmluv String? @db.Text

  /// Dostava dotazy klientu (zadani 11. 9. 2026). Kdo to ma zaskrtnute, sedi
  /// v kazdem kanalu, ktery klient otevre tlacitkem "Zeptat se" u projektu.
  prijimaDotazyKlientu Boolean @default(false)

  /// Vidi sekci Banka - napojeni uctu a parovani plateb (zadani 17. 9. 2026:
  /// „nastaveni a parovani banky bych mel videt jen ja a Bara Siblova").
  /// Priznak u uctu, ne seznam jmen v kodu: lidi se meni, kod by o tom nevedel.
  /// Vychozi je NE - do pohybu na uctu nema videt nikdo, komu se to vylozene
  /// nedovoli, ani ostatni Zuzo-labuzo.
  vidiBanku Boolean @default(false)

  /// NAHLEDOVY UCET - portal na zkousku (zadani 18. 9. 2026: „vytvor mi jeste
  /// jeden profil pro uzivatele, ktery nemuze nic menit, jen si muze
  /// vyzkouset cely portal z ruznych roli. Herec, Tym, Klient").
  ///
  /// Kdo to ma zaskrtnute, si v liste prepina, jako ktera role portal vidi
  /// (Tym / Klient / Herec) a ZADNY jeho pozadavek nic nezapise - middleware
  /// z takoveho uctu nepusti POST, PATCH, PUT ani DELETE. Viz lib/nahledRole.ts.
  ///
  /// Schvalne priznak u uctu, ne nova role: role rozhoduje v celem portalu o
  /// tom, co je videt, a nova by znamenala ukazovat neco jineho, nez vidi
  /// skutecny klient nebo herec.
  jenNahled Boolean @default(false)

  /// Hlida zmeny u projektu a vidi je pod zvonkem (zadani 18. 9. 2026:
  /// „potrebuju jeste at Peter vidi ve zvonecku notifikace o zmene datumu
  /// a zmene stavu projektu").
  /// Opet priznak u uctu, ne jmeno v kodu. Vychozi je NE - zvonek by jinak
  /// zvonil u kazde zmeny vsem a prestal by se cist.
  sledujeZmenyProjektu Boolean @default(false)

  // --- Upozorneni na zpravy v chatu (zadani 12. 9. 2026: „detailnejsi
  //     nastaveni notifikaci v chatu, at si nastavi kazdy sam individualne") ---
  //
  // Zvlast pro rozhovory a zvlast pro kanaly projektu: kanal projektu je
  // pracovni proud, kde clovek casto chce vedet jen o tom, kdyz se resi on,
  // zatimco kdyz mu nekdo pise primo, chce vedet o kazde zprave.
  /// Soukrome zpravy (zadani 12. 9. 2026: „potreboval bych jeste upravovat
  /// notifikace zvlast na soukrome zpravy a na individualni skupiny").
  chatUpozorneniZpravy ChatUpozorneni @default(VSE)
  /// Skupiny - obecne. Jednotliva skupina si to muze prebit vlastnim
  /// nastavenim, viz ConversationMember.upozorneni.
  chatUpozorneniSkupiny ChatUpozorneni @default(VSE)
  /// Kanaly projektu.
  chatUpozorneniKanaly ChatUpozorneni @default(ZMINKY)
  /// Zacatek a konec hodin, kdy upozorneni nechodi (0-23, cas v Praze).
  /// Kdyz je nekterá prazdna, ticho se neuplatnuje. Rozsah smi prechazet
  /// pres pulnoc (22 -> 7).
  chatTichoOd Int?
  chatTichoDo Int?

  /// Dostava zpravu, kdyz je herec na projektu dotoceny (zadani 11. 9. 2026:
  /// "info o dotoceno s hercem jde notifikaci mailem na Helenu Rychlik").
  /// Je to priznak u uctu, ne adresa v kodu - az to bude hlidat nekdo jiny,
  /// preklikne se to na karte uzivatele.
  dostavaDotoceno Boolean @default(false)

  /// KLIENT chce vedet, kdyz s hercem dotocime (zadani 16. 9. 2026:
  /// „potrebuji mit moznost nastavit u konkretnich klientu, aby jim chodily
  /// notifikace o tom, ze jsme dotocili s konkretnim hercem").
  ///
  /// Schvalne zvlast od dostavaDotoceno: ten je interni a nese VSECHNY
  /// projekty. Tenhle nese jen projekty, u kterych je ten clovek napsany jako
  /// klient - tedy presne ty, ktere v portalu vubec vidi. Bez toho by se
  /// zapnutim upozorneni dozvedel o zakazkach jinych oddeleni sve firmy.
  ///
  /// Zapina se na karte uzivatele v administraci, ale klient si to smi
  /// prepnout i sam v „Muj ucet" (zadani tyz den).
  dostavaDotocenoKlient Boolean @default(false)

  /// Dostava mail o nove objednavce od klienta (zadani 14. 9. 2026: "jednotlive
  /// adresy uzivatelu tymu, ktere si nastavim na webu v portalu").
  /// Stejny princip jako dostavaDotoceno - kdo objednavky hlida, se prekliká
  /// na karte uzivatele, nesedi to v promenne prostredi.
  dostavaObjednavky Boolean @default(false)

  /// Muze byt i zvukar (zadani 22. 9. 2026: „pridej Petera Dratvu, aby se mohl
  /// obcas i pridat jako zvukar k nekterym projektum"). Ucet si necha svou
  /// roli (napr. Zuzo-labuzo), jen se navic nabizi mezi zvukari v kalendari.
  takyZvukar Boolean @default(false)

  /// Dostava vyplnene udaje z odkazu pro herce a firmy (zadani 16. 9. 2026:
  /// „kdyz ho vyplni, tak se nam to automaticky propise do systemu a zahlasi
  /// Karoline - tohle bych chtel mit ale taky moznost menit do budoucna, komu
  /// to bude hlasit"). Zase priznak na uctu, ne jmeno v kodu.
  dostavaVyplneneUdaje Boolean @default(false)

  /// Vychozi manazer objednanych audioknih (zadani 15. 9. 2026: „manazer
  /// projektu u audioknih je vzdy Karolina"). Projekt zalozeny z objednavky
  /// audioknihy se priradi tomu, kdo to ma zaskrtnute - zase priznak na uctu,
  /// ne jmeno v kodu. Kdyz to nema nikdo, zustane manazer prazdny jako driv.
  vychoziManazerAudioknih Boolean @default(false)

  /// HEREC, KTERY JE ZAROVEN DODAVATEL (zadani 16. 9. 2026: „nekdy se nam
  /// stane, ze herec je i dodavatel, takze bych potreboval mit u herce moznost
  /// prenest ho do dodavatelu. Aby pak byl zaroven herec, ale i dodavatel").
  ///
  /// Nemeni se tim role ani firma uctu: herec zustava hercem a `companyId`
  /// (firma, POD kterou clovek patri) se nehne - tohle je firma, kterou
  /// SAM JE. Smlouva o dilo se uzavira s ni, ne s uctem.
  dodavatelCompanyId String?
  dodavatelCompany   Company? @relation("HerecDodavatel", fields: [dodavatelCompanyId], references: [id])

  /// U kterych projektu je tenhle herec dotoceny.
  dotoceniHerce HerecDotocen[] @relation("DotocenyHerec")

  /// Kam se s timhle hercem doteklo natacení (vede Bruno - viz BrunoNatoceno).
  brunoNatoceno BrunoNatoceno[] @relation("BrunoNatocenoHerec")

  /// Bonusy za audioknihy, ktere portal navrhl tomuhle zvukari
  /// (zadani 15. 9. 2026 - viz model BonusZvukare).
  bonusy BonusZvukare[] @relation("BonusZvukare")

  /// Pripominky k portalu, ktere tenhle clovek poslal (zadani 15. 9. 2026).
  pripominky PripominkaPortalu[] @relation("PripominkyPortalu")

  // --- Herec - zadani 5. 9. 2026: samostatna fyzicka osoba, bez firmy ---
  /// Projekty, ve kterych herec hraje (zadani 10. 9. 2026, vic hercu na projekt).
  projektyJakoHerec ProjectMeta[] @relation("ProjektHerci")

  studioLocations String[] @default([]) // lokace, ve kterych je herec schopen fyzicky natacet - viz lib/roles.ts HEREC_STUDIOS

  /// STUDIA ZVUKARE (zadani 20. 9. 2026: „jeste pojdme udelat lokalizace
  /// zvukaru ... udelej asi ze zvukaru v uzivatelich zaskrtavatka").
  ///
  /// Schvalne vazba na skutecna studia, ne dalsi seznam jmen jako
  /// `studioLocations` u herce: zvukar sedi v konkretni mistnosti (Brno I,
  /// Brno II, Praha) a podle toho se nabizi ke konkretni frekvenci. Kdyz
  /// pribude studio, zaskrtavatko se objevi samo.
  zvukarStudia Studio[] @relation("ZvukarStudia")
  /// VEDOUCI POBOCKY (zadani 22. 9. 2026: „Tomas Ilavsky by mel mit pristup
  /// k upravam i brnenskych kalendaru. Je to vedouci pobocky. A to same
  /// Ondrej Cerny ml. v Praze"). V techto studiich smi upravovat kalendar
  /// jako produkce - zapsat, posunout a smazat udalost.
  vedeStudia   Studio[] @relation("VedouciStudia")
  /// Účet tabule (role TABULE) - které studio ukazuje (22. 9. 2026).
  tabuleStudioId String?
  tabuleStudio   Studio? @relation("TabuleUcet", fields: [tabuleStudioId], references: [id], onDelete: SetNull)
  /// PRISTUP NA TABULE (zadani 23. 9. 2026: „dej pristup na brnenske tabule
  /// Tomasi Ilavskemu a celemu zuzo-labuzo. A pak v Praze Ondrej Cerny ml").
  /// Clovek z tymu si tabuli otevre pod svym uctem - nemusi se prihlasovat
  /// uctem tabule ani znat jeji adresu.
  tabulePristup  Studio[] @relation("TabulePristup")
  birthNumber     String?   // RC, nebo datum narozeni jako text, pokud herec RC nema (cizinec apod.)
  ic              String?
  dic             String?
  vatPayer        Boolean   @default(false) // platce DPH
  bankAccount     String?
  // Adresa rozdelena na samostatna pole (zadani 8. 9. 2026: "vice poli na
  // adresu") - misto jednoho pole address, ktere ma pro srovnani Dodavatel
  // (Company) u Firmy.
  addressStreet   String?   // ulice a cislo popisne
  addressCity     String?   // mesto
  addressZip      String?   // PSC
  addressCountry  String?   // zeme

  /// JESTE NEDOPLNIL SVE UDAJE (zadani 16. 9. 2026: „po tom, co si herec
  /// nastavi heslo, ho to vyzve, at doplni udaje").
  ///
  /// Vychozi je TRUE, tedy „neni co doplnovat" - jinak by portal po nasazeni
  /// zastavil u formulare vsechny herce, kteri uz v nem davno jsou. Na false
  /// se to dava jen tem, kdo prijdou novou pozvankou.
  udajeDoplneny Boolean @default(true)

  // --- Pozvanka do portalu (zadani 5. 9. 2026) ---
  // Misto rucniho rozesilani hesel posle admin uzivateli pozvanku; odkaz v
  // e-mailu obsahuje jednorazovy token, kterym si uzivatel sam nastavi heslo.
  inviteToken        String?   @unique
  inviteTokenExpires DateTime?
  invitedAt          DateTime? // kdy byla naposledy odeslana pozvanka
  passwordSetAt      DateTime? // kdy si uzivatel naposledy nastavil heslo pres pozvanku

  orders          Order[]         @relation("OrderCreatedBy")
  managedProjects ProjectMeta[]   @relation("ProjectManager")
  /// Nabidky, ktere tenhle clovek klientovi odeslal (zadani 13. 9. 2026).
  odeslaneNabidky Offer[]         @relation("NabidkaOdeslal")
  timesheets      TimesheetEntry[]
  navrhyVykazu    NavrhVykazu[]
  tasks           Task[]
  menuItems       UserMenuItem[]
  /// Vlastni sloupce v tabulkach, zvlast pro pocitac a mobil (zadani 19. 9. 2026).
  nastaveniSloupcu UserColumnSetting[]
  quickActions    UserQuickAction[]
  conversationsCreated Conversation[]       @relation("ConversationCreatedBy")
  conversationMembers  ConversationMember[]
  messages             Message[]
  reactions            MessageReaction[]
  pushOdbery           PushOdber[]

  // Kalendare a natacecí frekvence (zadani 8. 9. 2026).
  actorOnProjects    ProjectMeta[]      @relation("ProjectActor")
  klientNaProjektech ProjectMeta[]      @relation("ProjektKlient")
  recordingRequests  RecordingRequest[] @relation("RecordingActor")
  recordingsCreated  RecordingRequest[] @relation("RecordingCreatedBy")
  recordingsDecided  RecordingRequest[] @relation("RecordingDecidedBy")
  recordingEvents    RecordingEvent[]   @relation("RecordingEventUser")
  studioBlocks       StudioBlock[]      @relation("StudioBlockCreatedBy")
  notifications      Notification[]
  calendarFeeds      CalendarFeed[]

  /// Zadosti o udaje, ktere se tykaji tohohle cloveka (doplneni jeho karty).
  pozvankyUdaju        PozvankaUdaju[] @relation("PozvankaUdajuKomu")
  /// Zadosti o udaje, ktere tenhle clovek rozeslal.
  pozvankyUdajuVytvoril PozvankaUdaju[] @relation("PozvankaUdajuVytvoril")

  /// Navody, ktere tenhle clovek napsal nebo naposledy upravil.
  navody Navod[] @relation("NavodAutor")

  /// Dovolene a dny mimo studio (zadani 19. 9. 2026) - viz model Nepritomnost.
  nepritomnosti Nepritomnost[] @relation("NepritomnostKdo")
  /// Porady, na které je pozvaný (zadání 21. 9. 2026).
  poradyUcast   PoradaUcastnik[]
}

model Order {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  createdByUserId     String
  createdBy           User              @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])

  // Druh objednavky (zadani 12. 9. 2026) - viz OrderKind vyse.
  kind                OrderKind         @default(AUDIOBOOK)

  title               String
  pageCount           Int?
  ratePerPageSnapshot Int?              // sazba v okamziku objednavky (pro dohledatelnost, i kdyz se sazba klienta pozdeji zmeni)
  priceEstimate        Int?             // predbezna cena = pageCount * ratePerPageSnapshot
  deadline             DateTime?
  note                 String?
  preferredNarrator    String?          // "Preferovany herec" - preni klienta, Mediaspace ho pak potvrdi nebo zmeni
  attachmentUrl        String?
  attachmentName       String?

  /// Úvod a závěr audioknihy (zadání 22. 9. 2026, zatím Audiotéka) - údaje,
  /// ze kterých se text skládá, a výsledné texty tak, jak je klient odeslal.
  autorKnihy           String?
  prekladatelKnihy     String?
  nakladatelstviKnihy  String?
  uvodKnihy            String?
  zaverKnihy           String?

  /// Příloha ve složce projektu na Disku (22. 9. 2026) - ID souboru, nebo
  /// proč se tam nedostala (ukazuje se v detailu projektu).
  diskPrilohaId        String?
  diskPrilohaChyba     String?

  status               OrderStatus       @default(NEW)
  emailSentAt          DateTime?

  caflouProjectId      String?
  caflouSyncStatus     CaflouSyncStatus  @default(SKIPPED)
  caflouSyncError      String?

  project              Project?

  createdAt            DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

// Lokalni cache projektu - dokud neni napojena plna synchronizace s Caflou,
// zaznam vznika pri kazde objednavce. Vyhledove se projekty budou zakladat
// primo v MS portalu (zadani 9. 9. 2026 - "Caflou casem nebudeme potrebovat
// a projekty budeme zakladat na MS portalu").
model Project {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])

  orderId         String?   @unique
  order           Order?    @relation(fields: [orderId], references: [id])

  name            String
  status          String?   // napr. Nove / V realizaci / Hotovo - z Caflou nebo rucne
  narrator        String?   // "Herec"
  finishDate      DateTime?
  releaseDate     DateTime?

  caflouProjectId String?   @unique

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Atomicke pocitadlo pro verejna ID uzivatelu/firem (MSF/MSI/MSH/MSK...) -
// viz lib/codes.ts. "name" je prefix (napr. "F", "I", "H", "K"), "value" je
// posledni pouzite cislo v teto rade.
model Counter {
  name  String @id
  value Int    @default(0)
}


// Priorita projektu - zadani 5. 9. 2026 (interni atribut, klient ji nevidi).
// Cim byl vydaj zaplaceny (zadani 10. 9. 2026 ke scanovani uctenek).
// Kartou a hotove je zaplaceno uz v okamziku vzniku dokladu, prevodem az
// pozdeji - podle toho se sam predvyplni priznak "uhrazeno".
// Odkud projekt pochazi (prechod z Caflou, 10. 9. 2026). Prenesene projekty
// se poznaji od tech, ktere uz vznikly primo v portalu.
// Komu jde zprava, kdyz projekt vstoupi do daneho stavu (zadani 10. 9. 2026).
enum KomuNotifikace {
  NIKAM   // v tomhle stavu se nic neposila
  KLIENT  // klientovi projektu (a v kopii nam)
  INTERNE // jen nam - klient se to dozvedet nema
}

enum ProjectSource {
  CAFLOU // preneseno jednorazovym prenosem z Caflou
  PORTAL // zalozeno v portalu
}

enum PaymentMethod {
  CARD     // platebni kartou
  CASH     // hotove
  TRANSFER // prevodem na ucet
}

enum ProjectPriority {
  LOW    // Nizka
  MEDIUM // Stredni
  HIGH   // Vysoka
}

// Interni doplnkove udaje k projektu, ktery zije v Caflou.
//
// Caflou zustava zdrojem pravdy pro samotny projekt (nazev, stav, terminy) -
// tohle je jen nase "obalka" navic, klicovana podle ID projektu v Caflou.
// Zaznam vznika az ve chvili, kdy nekdo z tymu neco vyplni (upsert), takze
// pro vetsinu projektu zadny radek neexistuje a to je v poradku.
//
// Videt to smi jen interni ucty Mediaspace (ADMIN/PRODUKCE/ZVUKAR), menit
// jen Produkce a Zuzo-labuzo - viz lib/roles.ts (canEditProjectMeta).
model ProjectMeta {
  id              String           @id @default(cuid())
  caflouProjectId String           @unique // ID projektu v Caflou (cislo jako text)

  driveUrl        String?          // "Odkaz na KZ" - slozka projektu na Google Disku
  managerUserId   String?          // manazer projektu - interni ucet Mediaspace
  manager         User?            @relation("ProjectManager", fields: [managerUserId], references: [id])
  priority        ProjectPriority?
  projectType     String?          // klic ciselniku - viz lib/projectTypes.ts (PROJECT_TYPES)

  // Herec projektu (zadani 8. 9. 2026). V Caflou je herec jen text ve vlastnim
  // sloupci - tady se jednou navaze na konkretni ucet a od te chvile se z toho
  // da stavet (nabidky terminu, notifikace, jeho vlastni prehled).
  /// PŮVODNÍ jeden herec. Od 10. 9. 2026 se herci vedou v `herci` níž - na
  /// projektu jich může být víc (zadání: "chci jich tam dát více"). Sloupec
  /// zůstává jako HLAVNÍ herec: drží se na prvním ze seznamu a spoléhají na
  /// něj starší části portálu (předvyplnění natáčecí frekvence). Nesmí se
  /// upravovat zvlášť - vždycky se dopočítá ze seznamu.
  actorUserId     String?
  actor           User?            @relation("ProjectActor", fields: [actorUserId], references: [id])

  /// Herci projektu (zadání 10. 9. 2026). Víc lidí na jednu knihu je běžné -
  /// dabing, dvojhlas, vypravěč plus postavy.
  herci           User[]           @relation("ProjektHerci")

  // Klient projektu (zadani 10. 9. 2026: "musime u kazdeho projektu jeste
  // nastavit, ci je ten projekt"). Konkretni clovek u klientske firmy, ne cela
  // firma - na nej chodi notifikace o projektu. V Caflou tuhle roli zastupoval
  // stitek se jmenem objednavajici osoby, proto se pri prenosu ulozi aspon
  // textem a ucet se k nemu doplni rucne.
  klientUserId    String?
  klient          User?            @relation("ProjektKlient", fields: [klientUserId], references: [id])
  klientName      String?

  /// Rodný list reklamního spotu (zadání 9. 9. 2026) - údaje, ze kterých se
  /// PDF vyrábí. Vedou se u projektu, do kódu se nic nepíše natvrdo.
  /// Název spotu je nepovinný; když chybí, použije se název projektu z Caflou.
  spotName          String?
  /// Délka spotu v sekundách - v dokumentu se zobrazí jako "20s".
  spotLengthSeconds Int?
  directorName      String?
  /// Klient na Rodném listu (zadání 10. 9. 2026). Předvyplní se celým názvem
  /// firmy projektu, ale jde přepsat - na dokumentu občas patří něco jiného
  /// (agentura, koncový zadavatel) než firma, které se fakturuje.
  rlClientName      String?
  /// Sekce "Hudba ve spotu" - záměrně jen tahle dvě pole, žádná licence.
  musicTitle        String?
  musicAuthor       String?
  /// Spot hudbu nemá - hudební pole se pak nevyžadují a RL neuvede nepravdu.
  noMusic           Boolean          @default(false)
  productionDate    DateTime?

  /// Poslední stav projektu, který jsme v Caflou viděli. Caflou nám změnu
  /// nehlásí, takže se SKUTEČNÝ přechod do stavu "Dokončeno - ke schválení"
  /// pozná právě porovnáním s touhle hodnotou (viz lib/rodnyListServer.ts).
  lastCaflouStatus  String?
  /// Poslední chyba při vytváření Rodného listu. Dokud je vyplněná, projekt
  /// se internímu týmu ukazuje jako vyžadující kontrolu a klientovi nic nešlo.
  rlError           String?

  // --- VLASTNI DATA PROJEKTU (prechod z Caflou, 10. 9. 2026) ---------------
  // Do 10. 9. 2026 se nazev, firma, stav a dalsi udaje cetly pri kazdem
  // zobrazeni z Caflou a tahle tabulka drzela jen nase vlastni atributy.
  // Mediaspace ale Caflou opousti, takze projekt ted zije tady. Klic
  // caflouProjectId zustava tim, cim byl - jednoznacnym ID projektu, na ktere
  // se odkazuji doklady, vykazy, rozpocty i rodne listy. Nove projekty
  // dostanou vlastni ID; jen uz nepochazi z Caflou.
  name            String?
  companyId       String?
  company         Company?         @relation("ProjektFirma", fields: [companyId], references: [id])
  /// Nazev firmy textem - projekt zustane citelny, i kdyz firma v portalu neni.
  companyName     String?
  statusName      String?
  finished        Boolean          @default(false)
  pageCount       Int?
  /// Herec jako text, jak byl v Caflou. Navazany ucet je v actorUserId vyse.
  narrator        String?
  releaseDate     DateTime?
  startDate       DateTime?
  endDate         DateTime?
  /// Popis projektu. V Caflou se do nej psal odkaz na slozku projektu.
  popis           String?          @db.Text
  /// UCEL A UZEMI UZITI LICENCE (zadani 17. 9. 2026: „uziti licence bych jeste
  /// dal jako atribut v detailu projektu a na smlouvu by se taky predvyplnil").
  /// U reklamy to rika, kde a jak smi klient spot pouzit - „audio reklama na
  /// Spotify, CZ+SK". Je to udaj projektu, ne smlouvy: pise se do kazde
  /// smlouvy na ten spot stejne.
  licenceUziti    String?

  /// ÚVOD A ZÁVĚR AUDIOKNIHY (zadání 22. 9. 2026) - přijde z objednávky
  /// (Audiotéka), v detailu projektu se dá upravit. Čte ho herec na začátku
  /// a na konci nahrávky.
  uvodKnihy       String?
  zaverKnihy      String?

  /// DRUHY LICENCE (zadani 18. 9. 2026: „potrebuju mit moznost zaskrtnout
  /// v detailu projektu nekde licenci... melo by jit pridat i vic druhu te
  /// licence k jednomu projektu"). Ciselnik si tym spravuje v Cenicich,
  /// projekt jich muze mit vic naraz - spot bezi v TV i online.
  licence         DruhLicence[]    @relation("ProjektLicence")
  /// Co se stavem udelalo tlacitko "Dotoceno" u herce (zadani 11. 9. 2026).
  /// Podle toho se pozna, jestli se odskrtnutim herce smi stav vratit: kdyz
  /// uz nekdo posunul projekt dal (Dotoceno -> Dotoceno/strihame), vracet
  /// neni co a portal na stav nesahne.
  dotocenoStavPred String?
  dotocenoStavPo   String?

  /// KLIENT SPOT SCHVALIL (zadani 18. 9. 2026: „stisknutim toho tlacitka,
  /// kdyz to klient schvali, se nam dany spot nebo reklama preklopi do stavu
  /// schvaleno k fakturaci").
  ///
  /// Ulozeny okamzik, ne jen stav: stav se muze jeste rucne prehodit, ale
  /// „klient to odklepl tehdy a tehdy" ma zustat. Zaroven je to pojistka
  /// proti druhemu kliknuti - schvaleni se nedeje dvakrat.
  schvalenoKlientemAt DateTime?

  zdroj           ProjectSource    @default(CAFLOU)
  /// Kdy projekt prisel jednorazovym prenosem z Caflou.
  prenesenoAt     DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([finished])
  @@index([companyId])
  @@index([name])
}


// Notifikace klientovi podle stavu projektu (zadani 10. 9. 2026: "u firem
// zalozka Notifikace, kde pujde nastavit individualne, v jake fazi projektu
// pujde zprava na klienta").
//
// Kazda firma to ma jinak: Audioteka chce vedet uz o prvnich trackach,
// Jota az o hotovem projektu a prvni dva stavy chce jen internimu tymu.
// Proto radek na dvojici firma + stav.
//
// Co ulozene neni, se NEPOSILA. Radeji zpravu neposlat, nez ji poslat
// klientovi, ktery o ni nestoji.
// Archiv smazanych zaznamu (zadani 10. 9. 2026: "pak se jeste muzu
// rozhodnout, zda o ne prijdu, nebo ty veci konkretni archivuju a smazu
// uzivatele, firmu atd.").
//
// Kdyz na firme/uzivateli/projektu neco visi, portal smazani odmitne a
// vypise co. Odtud vedou dve cesty a archiv je ta bezpecna: vsechno
// navazane se ulozi sem jako JSON, teprve pak se to z portalu odstrani.
// Archiv se da stahnout - je to posledni zachrana, kdyz se nekdo ukliknul.
enum DruhArchivu {
  FIRMA
  UZIVATEL
  PROJEKT
  // Hromadne vycisteni kalendare studia (zadani 20. 9. 2026).
  KALENDAR
}

model Archiv {
  id            String      @id @default(cuid())
  druh          DruhArchivu
  /// Jmeno firmy / uzivatele / projektu, jak se jmenoval pri smazani.
  nazev         String
  /// ID smazaneho zaznamu - u projektu caflouProjectId.
  puvodniId     String
  /// "3x faktura, 1x projekt" - at je ze seznamu hned videt, co v archivu je.
  souhrn        String
  pocetZaznamu  Int         @default(0)
  /// Kompletni data vsech navazanych zaznamu.
  obsah         Json

  uzivatelId    String?
  uzivatelJmeno String?
  createdAt     DateTime    @default(now())

  @@index([druh, createdAt])
}

// Historie projektu (zadani 10. 9. 2026: "neco jako LOG u kazdeho projektu -
// takovou historii, co se v projektu upravilo a kdy sla nejaka notifikace").
//
// Zamerne bez vazby na ProjectMeta pres cizi klic: na projekt se vsude v
// portalu odkazuje textovym caflouProjectId (doklady, vykazy, rozpocty,
// rodne listy) a historie to ma delat stejne - prezije to i smazani projektu.
/// Kdy chce clovek vedet o nove zprave v chatu (zadani 12. 9. 2026).
enum ChatUpozorneni {
  VSE     // kazda zprava
  ZMINKY  // jen kdyz me nekdo zmini nebo odpovi v mem vlakne
  NIC     // nic
}

enum DruhUdalosti {
  ZALOZENO    // projekt vznikl
  ZMENA       // nekdo zmenil udaj
  NOTIFIKACE  // odesla (nebo neodesla) zprava o stavu
  BRUNO       // neco vycetl z chatu asistent Bruno (zadani 12. 9. 2026)
}

model ProjektUdalost {
  id              String       @id @default(cuid())
  caflouProjectId String
  druh            DruhUdalosti @default(ZMENA)

  /// Klic zmeneneho pole (name, statusName, ...). U notifikace a zalozeni prazdne.
  pole            String?
  /// Veta, jak se to ukaze cloveku - at se historie da cist bez prekladace klicu.
  popis           String       @db.Text
  /// Hodnoty uz prelozene do citelne podoby (jmeno manazera, ne jeho ID).
  predchozi       String?      @db.Text
  nova            String?      @db.Text

  /// Kdo to udelal. Prazdne = portal sam (napr. odeslana notifikace).
  uzivatelId      String?
  /// Jmeno textem - zaznam zustane citelny, i kdyz ucet pozdeji zmizi.
  uzivatelJmeno   String?

  createdAt       DateTime     @default(now())

  @@index([caflouProjectId, createdAt])
}

model NotifikaceFirmy {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Nazev stavu z lib/stavyProjektu.ts - stejny text, jaky ma projekt.
  stav      String
  komu      KomuNotifikace @default(NIKAM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, stav])
  @@index([companyId])
}

// Co uz bylo o projektu odeslano (zadani 10. 9. 2026).
//
// Bez tehle tabulky by se zprava poslala pokazde, kdyz nekdo stav prehodi
// tam a zpatky - a hlavne by se poslala dvakrat u dvojice
// "Nataceni/strihame" -> "Dotoceno/strihame", kde obe zpravy rikaji totez:
// na disku jsou prvni tracky. Proto se u nich pamatuje spolecna znacka
// (viz ZNACKA_PRVNI_TRACKY v lib/notifikaceProjektuServer.ts).
model NotifikaceOdeslana {
  id              String   @id @default(cuid())
  caflouProjectId String
  /// Znacka zpravy - obvykle nazev stavu, u prvnich tracku spolecna pro dva stavy.
  znacka          String
  /// Komu to slo - kvuli dohledani, kdyz se nekdo pta "prislo to klientovi?".
  prijemci        String
  odeslanoAt      DateTime @default(now())

  @@unique([caflouProjectId, znacka])
  @@index([caflouProjectId])
}

// Cenik (zadani 5. 9. 2026). Polozka cenika slouzi zaroven jako ciselnik
// TYPU PROJEKTU - u projektu jde vybrat jen to, co je tady. Proto je nazev
// unikatni a v ProjectMeta.projectType se uklada primo nazev polozky.
model PriceListItem {
  id          String   @id @default(cuid())
  name        String   @unique // "Natáčení voiceoveru", "Výroba rádiového spotu"...
  priceExVat  Int?     // cena bez DPH v Kc
  priceIncVat Int?     // cena s DPH v Kc
  active      Boolean  @default(true) // vyrazena polozka se uz nenabizi u novych projektu

  /// Radiovy spot - u projektu s timhle typem se vyrabi Rodny list
  /// (upresneni 9. 9. 2026: "plati to jen u radiovych spotu"). Zamerne je to
  /// priznak na polozce ceniku, ne hadani podle nazvu: nazvy se prejmenovavaji
  /// a pribyvaji, tohle si tym prepne v administraci.
  rodnyList   Boolean  @default(false)

  /// Typ projektu, ktery dostane projekt zalozeny z OBJEDNAVKY AUDIOKNIHY
  /// (zadani 15. 9. 2026: „rovnou pridej typ projektu"). Priznak sedi na
  /// polozce ceniku ze stejneho duvodu jako `rodnyList`: nazvy se meni a
  /// hadat typ podle slova „audiokniha" by po prvnim prejmenovani prestalo
  /// platit. Zaskrtnuta smi byt jen jedna polozka - vyber je v Cenicich.
  proObjednavkyAudioknih Boolean @default(false)

  /// Ikona typu projektu (zadani 10. 9. 2026) - klic z lib/ikonyTypu.tsx.
  /// Sviti pred nazvem projektu v prehledu. Je to na polozce ceniku, ne
  /// v kodu: typy projektu si tym pridava sam a napevno zadana ikona by nove
  /// polozce nikdy nepatrila. Prazdne = polozka ikonu nema.
  ikona       String?

  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// Druh prace ve vykazu zvukare (zadani 6. 9. 2026).
enum WorkType {
  RECORDING // natáčení
  EDITING   // střih
  OTHER     // ostatní - práce, která nepatří ke konkrétnímu projektu (zadání 8. 9. 2026)
}

// Vykaz prace zvukare (zadani 6. 9. 2026): den, cas od-do, druh prace,
// projekt. Pocet hodin i castka se dopocitavaji - v databazi drzime cas v
// minutach od pulnoci (spolehlive se s tim pocita) a sazbu v okamziku zapisu,
// aby pozdejsi zmena sazby neprepsala uz vykazane dny.
model TimesheetEntry {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date               DateTime // den prace (bez casu)
  startMinutes       Int      // od - minuty od pulnoci
  endMinutes         Int      // do - minuty od pulnoci
  workType           WorkType

  // Projekt z Caflou. Nazev si ukladame i textove, aby vykaz zustal citelny,
  // kdyz projekt v Caflou zmizi nebo se prejmenuje.
  // U druhu prace "Ostatni" se projekt nevybira, takze oboji zustane prazdne.
  caflouProjectId    String?
  projectName        String?

  hourlyRateSnapshot Int      // sazba pouzita pro tenhle vykaz
  note               String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, date])
}


// Parametry vypoctu rozpoctu audioknihy (zadani 6. 9. 2026). Drzi se v
// databazi jako jediny radek, aby se daly menit v administraci bez zasahu do
// kodu - kazde studio si je casem doladi.
model BudgetSettings {
  id                 String   @id @default("default")
  pagesPerSession    Int      @default(40)  // kolik NS herec nacte za jednu frekvenci
  sessionHours       Int      @default(4)   // delka jedne frekvence v hodinach
  editingCoefficient Int      @default(120) // strih jako % z poctu frekvenci (120 = +20 %)
  bonusPerPage       Int      @default(4)   // bonus zvukari v Kc za normostranu
  hourlyRate         Int      @default(250) // sazba, ze ktere se pocita cena frekvence
  // Jak dlouho se drzi terminy vybrane hercem, nez je produkce potvrdi
  // (zadani 8. 9. 2026). Po vyprseni se uvolni zpatky do nabidky.
  holdHours          Int      @default(72)
  updatedAt          DateTime @updatedAt
}


// Polozky horni fialove listy (zadani 6. 9. 2026: "měla by být možnost si
// modifikovat odkazy nahoře v menu v horní fialové liště"). Dokud je tabulka
// prazdna, portal pouziva vychozi sadu z src/lib/menu.ts - lista se tedy
// nikdy nezobrazi prazdna. Editor je v /admin/menu.
// Horni lista si ji kazdy uzivatel sklada SAM (zadani 8. 9. 2026: "uprava
// menu by se mela tykat kazdeho uzivatele zvlast - kdyz jsem si dal pryc
// vykazy, zmizelo to i zvukarum"). Kdo radky nema, vidi vychozi listu z
// lib/menu.ts > DEFAULT_MENU_ITEMS. Viditelnost se tu neresi - tu urcuji
// prava ke strance (PAGE_ACCESS).
/// Rychla volba v levem panelu (zadani 9. 9. 2026). Panel patri konkretnimu
/// uzivateli, stejne jako horni lista - uprava se nikomu jinemu nepromitne.
/// Ulozeny je jen KLIC akce; popisek, ikona i cil patri ke kodu
/// (viz lib/quickActions.ts), aby se daly kdykoliv zmenit.
model UserQuickAction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionKey String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, actionKey])
  @@index([userId, sortOrder])
}

model UserMenuItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // co je videt v liste
  href      String   // "/projekty" nebo vlastni https:// odkaz
  sortOrder Int      @default(0)
  /// Pro jake zarizeni lista plati: "POCITAC" nebo "MOBIL" (zadani 19. 9. 2026:
  /// „moznost si jinak poskladat hlavni nabidku v mobilni aplikaci a jinak na
  /// pocitaci"). Starsi radky jsou lista pocitace.
  zarizeni  String   @default("POCITAC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
  @@index([userId, zarizeni])
}

/// SLOUPCE V TABULKACH PODLE CLOVEKA A ZARIZENI (zadani 19. 9. 2026: „a taky
/// to, jake se mi zobrazuji sloupce v prehledu projektu" - jinak v mobilu,
/// jinak na pocitaci). Kazdy si nastavuje JEN poradi a skryti; nazvy sloupcu
/// jsou spolecne pro vsechny (ColumnLabel) a meni je Zuzo-labuzo.
model UserColumnSetting {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableKey  String
  /// "POCITAC" nebo "MOBIL"
  zarizeni  String
  columnKey String
  sortOrder Int     @default(0)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tableKey, zarizeni, columnKey])
  @@index([userId, tableKey, zarizeni])
}


// Firmy nactene z Caflou (zadani 8. 9. 2026: "nahraj databazi firem, ktere
// mame v Caflou - jsou tam najednou klienti i herci, to bychom si roztridili").
//
// Zamerne to NENI zapis do modelu Company: tam kazdy radek znamena tenanta s
// uzivateli, slozkou na Disku a napojenim na Caflou, kdezto tady je surovy
// seznam z Caflou k roztrideni. Diky tomu nemuzou vzniknout duplicity mezi
// tim, co uz v portalu je, a tim, co se prave stahlo (zprava uzivatele
// 8. 9. 2026: "bacha na duplicity, nektere firmy uz mam v MS portalu").
// Klicem je ID z Caflou, takze opakovany import stejnou firmu jen aktualizuje.
enum CaflouContactKind {
  NEZARAZENO
  KLIENT
  HEREC
  IGNOROVAT
}

model CaflouCompany {
  id             String   @id // ID firmy v Caflou
  name           String
  ic             String?
  dic            String?
  email          String?
  phone          String?
  addressStreet  String?
  addressCity    String?
  addressZip     String?
  addressCountry String?
  note           String?

  // Roztrideni - kdo je klient a kdo herec. Zatim jen znacka, zakladani
  // skutecnych firem a uctu prijde az potom.
  kind           CaflouContactKind @default(NEZARAZENO)
  // Podle ceho se to roztridilo - at je videt, jestli rozhodlo pole z Caflou,
  // nebo jen odhad z nazvu, a da se to rychle prekontrolovat.
  kindReason     String?

  // Cela puvodni odpoved z Caflou, at se da kdykoliv domapovat dalsi pole
  // bez opakovaneho importu.
  raw            Json

  importedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind])
  @@index([name])
}

// Komunikacni kanal pro tym (zadani 8. 9. 2026: "vytvor komunikacni kanal
// jako Slack pro tym - misto Kanalu to bude nazvano Projekty, pak soukrome
// zpravy a skupinovy chat"). Zatim zamerne jednoduche: text, zadne prilohy,
// reakce ani vlakna - "do budoucna na to udelame samostatnou aplikaci".
//
// Chat je jen pro tym Mediaspace (stejne jako Ukoly), klienti a herci se k
// nemu vubec nedostanou.
enum ConversationKind {
  PROJEKT   // kanal k jednomu projektu z Caflou - vidi ho cely tym
  SOUKROMA  // zprava mezi dvema lidmi
  SKUPINA   // pojmenovana skupina vic lidi
  DOTAZ     // dotaz klienta k jeho projektu (zadani 11. 9. 2026)
}

model Conversation {
  id              String           @id @default(cuid())
  kind            ConversationKind
  // Nazev: u skupiny zadany rucne, u projektu nazev projektu (drzime si ho i
  // textove, aby byl kanal citelny, kdyz projekt v Caflou zmizi).
  name            String?
  caflouProjectId String?          @unique

  /// Kanal dotazu klienta k projektu (zadani 11. 9. 2026: "tlacitko Zeptat se
  /// v klientske sekci"). Klic je dvojice projekt + firma, takze kazda firma
  /// ma u sveho projektu jeden kanal - a nekolizuje s kanalem PROJEKT, ktery
  /// drzi caflouProjectId vyse.
  dotazProjektId String?
  dotazCompanyId String?
  /// Kdy se kanal uzavrel (projekt skoncil). Historie zustava dohledatelna,
  /// jen uz kanal neni v seznamu.
  uzavrenoAt     DateTime?

  /// Skupina, do ktere patri cely tym (zadani 12. 9. 2026: „a jeste nejakou
  /// skupinu Mediaspace All, kde budou vzdy pridani vsichni, i kdyz se prida
  /// uzivatel pozdeji"). Clenstvi se u ni nespravuje rucne - kdo je v tymu,
  /// ten je v ni, a doplni se sam pri prvnim otevreni chatu.
  vsichni        Boolean          @default(false)

  createdById     String
  createdBy       User             @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  // Kvuli razeni seznamu - posledni zprava nahore.
  lastMessageAt   DateTime         @default(now())

  members         ConversationMember[]
  messages        Message[]

  @@unique([dotazProjektId, dotazCompanyId])
  @@index([kind, lastMessageAt])
}

// Clenstvi drzi hlavne stav precteni. U kanalu k projektu se radek zaklada az
// ve chvili, kdy tam nekdo poprve zajde - kanal vidi cely tym bez ohledu na to.
model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  /// Ztlumeny rozhovor (zadani 12. 9. 2026). Zprava se dorucuje dal a je
  /// videt jako neprectena - jen z nej nechodi upozorneni. Nejcasteji
  /// pouzivane nastaveni ze vsech: jeden ukecany kanal se umlci a zbytek
  /// zustava, jak byl.
  ztlumeno       Boolean      @default(false)

  /// Pripnuty rozhovor - drzi se nahore jako rychla volba (zadani 12. 9.
  /// 2026). Patri CLOVEKU, ne rozhovoru: kazdy si nahoru da to svoje.
  pripnuto       Boolean      @default(false)

  /// Poradi mezi pripnutymi, kdyz si ho clovek prerovnal pretazenim (zadani
  /// 12. 9. 2026). Prazdno znamena "jeste nikdy nerovnal" - takove jdou az za
  /// serazene, od nejcerstvejsi zpravy.
  poradiPripnuti Int?

  /// Upozorneni pro TENHLE JEDEN rozhovor (zadani 12. 9. 2026: „na
  /// individualni skupiny"). Prazdno = plati obecne nastaveni uctu podle
  /// druhu rozhovoru. Ztlumeni vyse je totez co NIC a drzi se s tim v souladu.
  upozorneni     ChatUpozorneni?

  /// Uklizeny rozhovor (zadani 12. 9. 2026: „ty konverzace bych mazal treba
  /// prejetim doleva"). ZPRAVY SE NEMAZOU - zmizi jen z MEHO seznamu, druha
  /// strana ma svoje. Kdyz prijde nova zprava, rozhovor se vrati: proto se
  /// drzi i cas, kdy se uklidil.
  skryto         Boolean      @default(false)
  skrytoAt       DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  // Uprava vlastni zpravy (zadani 9. 9. 2026: "bylo by super upravovat me
  // odeslane zpravy, kdyz se treba spletu"). Drzi se jen cas posledni upravy,
  // ne historie verzi - v pracovnim chatu by k nicemu nebyla a je to citlivy
  // udaj navic. Prazdno znamena, ze zprava je v puvodnim zneni.
  editedAt       DateTime?

  // Odpovedi ve vlakne (zadani 8. 9. 2026: "odpovedi ve vlakne, jak je u
  // Slacku"). Odpoved ukazuje na zpravu, pod kterou visi; v hlavnim proudu
  // kanalu se zobrazuji jen zpravy bez rodice.
  parentId       String?
  parent         Message?     @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Message[]    @relation("MessageThread")

  reactions      MessageReaction[]
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([parentId])
}

// Odber upozorneni na nove zpravy (zadani 9. 9. 2026 k aplikaci MS Chat).
//
// Jeden radek = jedno zarizeni, ne jeden clovek: kdo ma chat na mobilu
// i na pocitaci, ma dva odbery a upozorneni dostane na obe. Endpoint je
// unikatni, takze opakovane povoleni na tomtez zarizeni radek jen prepise.
//
// Klice p256dh a auth patri k zarizeni a slouzi k zasifrovani obsahu
// upozorneni - bez nich by je prohlizec neprijal.
model PushOdber {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Odkud odber prisel - jen pro orientaci, kdyby se hledala chyba.
  zarizeni  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Priloha zpravy v chatu - fotka, PDF, zvukovy soubor se spotem (zadani
// 9. 9. 2026: "a co vkladani fotek nebo jinych priloh").
//
// V "key" NENI verejna adresa, ale klic souboru v uloziti. Odkaz ke stazeni
// se vydava az na vyzadani a jen na par minut - v chatu muzou byt klientske
// materialy, takze trvala verejna adresa by znamenala, ze staci link poslat
// dal a vidi to kdokoliv.
//
// Puvodni nazev souboru se drzi zvlast, protoze v klici je jen ocisteny tvar
// bez diakritiky - uzivatel ma pri stazeni dostat presne to, co nahraval.
model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  key       String
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@index([messageId])
}

// Reakce smajlikem na konkretni zpravu (zadani 9. 9. 2026: "jeste bych tam
// pridal reakce smajlikama na text - myslim na konkretni zpravu").
//
// Jeden clovek muze dat jedne zprave kazdy smajlik nejvys jednou - o to se
// stara unikatni index nize. Dalsi kliknuti na tentyz smajlik reakci zase
// odebere, jako u Slacku.
//
// V "code" je bud zkratka naseho smajlika (":ms-palec:"), nebo primo emoji
// ("👍"). Co je platne, hlida seznam v lib/chat.ts - do databaze se nikdy
// nedostane nic, co neni v nabidce.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, code])
  @@index([messageId])
}

// Ukoly (to-do) na profilu clena tymu Mediaspace - zadani 5. 9. 2026
// ("nejaky widget s ukoly u profilu Mediaspace"). Ukol patri vzdy konkretnimu
// uzivateli; nikdo jiny nez on (a admin) ho nevidi.
model Task {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  done      Boolean   @default(false)
  dueDate   DateTime? // termin, nepovinny
  /// Cas terminu „HH:MM" v Praze (zadani 21. 9. 2026: „u ukolu potrebuji
  /// nastavit i cas do kdy"). Prazdny = do konce dne, jako driv.
  dueTime   String?
  sortOrder Int       @default(0)

  /// Kdo ukol zadal z chatu pres @ukol (zadani 18. 9. 2026). Ulozene jmeno,
  /// ne vazba na ucet: ukol ma davat smysl i za rok, kdy uz ten clovek
  /// v portalu treba nebude. Prazdne = clovek si ukol napsal sam.
  zadalJmeno String?
  /// Konverzace, ze ktere ukol vznikl - at se da dokliknout na souvislosti.
  zdrojKonverzaceId String?

  /// KDO UKOL ZADAL - id uctu (zadani 21. 9. 2026: „kdyz vytvorim nekomu
  /// dalsimu ukol z chatu, potrebuji videt nekde, ze jsem ho vytvoril a ze
  /// ho pak ten clovek splnil"). Podle nej se zadavateli skladá seznam
  /// „Zadal jsem" a chodi mu zprava, kdyz je ukol splneny. Zamerne bez vazby
  /// na User (stejne jako zadalJmeno): kdyz ucet zmizi, ukol zustava.
  zadalId   String?
  /// Kdy prijemce ukol odskrtl. Vraceni mezi otevrene ho zase smaze.
  splnenoAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, done])
  @@index([zadalId, done])
}


// ===========================================================================
// DOKLADY (zadani 6. 9. 2026) - vlastni fakturacni firmy, ciselne rady,
// bankovni ucty a nabidky. Vse pracuje s menami: castka se vzdy uklada spolu
// s kodem meny, nikdy jako hole cislo.
// ===========================================================================

// Meny, ve kterych Mediaspace fakturuje (zadani 8. 9. 2026: CZK, EUR a libry;
// 17. 9. 2026 pribyl dolar kvuli vydajum placenym v USD).
enum Currency {
  CZK
  EUR
  GBP
  USD
}

// "Moje firmy" - fakturacni jednotky, za ktere Mediaspace vystavuje doklady.
// Pocita se s vic firmami pod jednou znackou, proto se u kazdeho dokladu
// vybira, za kterou se vystavuje.
model IssuerCompany {
  id             String   @id @default(cuid())
  name           String
  ic             String?
  dic            String?
  vatPayer       Boolean  @default(true)

  addressStreet  String?
  addressCity    String?
  addressZip     String?
  addressCountry String?  @default("CZ")

  email          String?  // odesilatel dokladu
  phone          String?
  logoUrl        String?
  /// Naskenovany podpis jako PNG data URL (pruhledne pozadi) - tiskne se na
  /// faktury (zadani 21. 9. 2026: „na fakturach chybi muj podpis").
  podpis         String?  @db.Text

  // Ciselne rady. Format se sklada ze zastupnych znaku - {YYYY} rok, {YY} rok
  // dvojcislim, {MM} mesic, {NNN}/{NNNN}/{NNNNN} poradove cislo doplnene
  // nulami. Pocatecni cislo jde nastavit, aby slo navazat na radu z Caflou.
  invoiceNumberFormat String @default("{YYYY}{NNN}")
  invoiceNextNumber   Int    @default(1)
  offerNumberFormat   String @default("N{YYYY}{NNN}")
  offerNextNumber     Int    @default(1)
  // Rada pro smlouvy (zadani 8. 9. 2026).
  contractNumberFormat String @default("S{YYYY}{NNN}")
  contractNextNumber   Int    @default(1)

  defaultCurrency Currency @default(CZK)
  isDefault       Boolean  @default(false) // predvybrana firma u novych dokladu
  active          Boolean  @default(true)

  bankAccounts BankAccount[]
  offers       Offer[]
  invoices     Invoice[]
  expenses     Expense[]
  contracts    Contract[]
  /// Napojene ucty u GoCardless (17. 9. 2026).
  bankConnections BankConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bankovni ucty vlastni firmy - jeden na kazdou menu, klidne i vic
// (zadani 8. 9. 2026: "bude dobré mít i možnost nastavit více účtů").
model BankAccount {
  id              String        @id @default(cuid())
  issuerCompanyId String
  issuer          IssuerCompany @relation(fields: [issuerCompanyId], references: [id], onDelete: Cascade)

  label         String   // "Air Bank CZK", "Fio EUR"...
  accountNumber String?  // tuzemsky tvar
  iban          String?
  swift         String?
  bankName      String?
  currency      Currency @default(CZK)
  isDefault     Boolean  @default(false) // predvybrany ucet pro tuhle menu
  sortOrder     Int      @default(0)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issuerCompanyId])
}

// Stav nabidky. Schvaleni dela klient odkazem s jednorazovym tokenem, takze
// se kvuli tomu nemusi prihlasovat.
enum OfferStatus {
  DRAFT    // rozpracovana
  SENT     // odeslana klientovi
  APPROVED // klient schvalil
  REJECTED // klient odmitl
}

model Offer {
  id              String        @id @default(cuid())
  number          String        @unique
  issuerCompanyId String
  issuer          IssuerCompany @relation(fields: [issuerCompanyId], references: [id])
  companyId       String        // odberatel - firma ze sekce Firmy
  company         Company       @relation(fields: [companyId], references: [id])

  currency   Currency  @default(CZK)
  issueDate  DateTime  @default(now())
  validUntil DateTime?
  subject    String?   // predmet nabidky
  note       String?

  /// Jazyk vytistene nabidky (zadani 10. 9. 2026).
  jazyk JazykDokladu @default(CS)

  status         OfferStatus @default(DRAFT)
  approvalToken  String      @unique // odkaz pro klienta ke schvaleni
  sentAt         DateTime?
  /// KDO NABIDKU ODESLAL (zadani 13. 9. 2026: „melo by se to menit podle toho,
  /// kdo je manazer projektu a kdo je prihlaseny"). Zapise se pri odeslani:
  /// manazer projektu, a kdyz projekt manazera nema, ten, kdo mail poslal.
  /// Z nej se bere podpis v mailu i na strance pro klienta - at se nerozejde
  /// jmeno v "Od", podpis a fotka.
  odeslalUserId  String?
  odeslal        User?       @relation("NabidkaOdeslal", fields: [odeslalUserId], references: [id])
  approvedAt     DateTime?
  approvedByName String?     // kdo na strane klienta schvalil
  rejectedAt     DateTime?

  items   OfferItem[]
  /// Faktury z teto nabidky. VIC NEZ JEDNA (zadani 15. 9. 2026: „kdyz bude
  /// nabidka na nejakou cenu a my to pak castecne vyfakturujeme... jestli to
  /// bude v pohode, kdyz z jedne nabidky udelam dve faktury"). Do 15. 9. 2026
  /// platilo jedna nabidka = jedna faktura a druha se odmitla; u vetsich
  /// zakazek se ale bezne fakturuje po castech.
  invoices Invoice[]

  // Vazba na projekt v Caflou (zadani 8. 9. 2026: "chtel bych mit Doklady
  // navazane na projekty"). Nazev drzime i textove, aby doklad zustal
  // citelny, kdyz projekt v Caflou zmizi nebo se prejmenuje.
  caflouProjectId String?
  projectName     String?

  /// SLEVA NA CELEM DOKLADU (zadani 14. 9. 2026: „potrebuju u nabidek
  /// a faktur mit moznost pridat nejakou slevu").
  ///
  /// Bud procenta, nebo pevna castka - obe naraz nedavaji smysl, takze plati
  /// procenta, kdyz jsou vyplnena. Sleva je VZDY BEZ DPH a rozpocita se mezi
  /// sazby podle jejich podilu na zaklade; jinak by u dokladu se dvema
  /// sazbami neseldila odvedena dan.
  slevaProcent Float   @default(0)
  slevaMinor   Int     @default(0)
  /// Co se na dokladu vytiskne vedle slevy, napr. „Sleva za objem".
  slevaPopis   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([caflouProjectId])
}

// Polozka nabidky. Cena se drzi v nejmensi jednotce meny (halere, centy,
// pence) jako cele cislo - s desetinnymi cisly by castky postupne ujizdely.
model OfferItem {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  description    String
  quantity       Float  @default(1) // klidne 2,5 hodiny
  unit           String? // "NS", "hod", "ks"
  unitPriceMinor Int     @default(0) // cena za jednotku bez DPH, v halerich/centech
  vatRate        Int     @default(21) // sazba DPH v procentech, 0 = bez DPH
  sortOrder      Int     @default(0)

  @@index([offerId])
}


// Stav faktury. Parovani plateb z banky prijde az s napojenim na Air Bank,
// zatim se uhrazeni oznacuje rucne.
enum InvoiceStatus {
  DRAFT     // rozpracovana
  SENT      // odeslana, ceka na uhrazeni
  PAID      // uhrazena
  CANCELLED // stornovana
}

// Vydana faktura (zadani 6. 9. 2026).
//
// Meny: castka se drzi v mene dokladu, a k tomu se ULOZI denni kurz CNB
// platny v den vystaveni (zadani 8. 9. 2026). Doklad si tak nese kurz, ktery
// pro nej platil, a pozdejsi pohyb na trhu s nim uz nehne.
/// Rezim DPH na dokladu (zadani 10. 9. 2026 - fakturujeme i do zahranici).
/// VYBIRA HO CLOVEK u konkretniho dokladu; portal ho nehada z adresy
/// odberatele, protoze to je vec ucetni, ne adresy.
enum RezimDph {
  STANDARD     // bezny rezim, sazby podle polozek
  PRENESENA    // dan odvede zakaznik
  MIMO_PREDMET // misto plneni je ve state prijemce
}

/// Jazyk vytisteneho dokladu.
enum JazykDokladu {
  CS
  EN
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  variableSymbol  String        // z cisla faktury, jen cislice
  issuerCompanyId String
  issuer          IssuerCompany @relation(fields: [issuerCompanyId], references: [id])
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])

  currency         Currency  @default(CZK)
  exchangeRate     Float     @default(1) // kolik CZK za 1 jednotku meny (CNB)
  exchangeRateDate DateTime? // ke kteremu dni kurz je

  issueDate DateTime  @default(now())
  taxDate   DateTime? // datum zdanitelneho plneni
  dueDate   DateTime?
  subject   String?
  note      String?

  /// Rezim DPH a jazyk vytisteneho dokladu (zadani 10. 9. 2026).
  rezimDph RezimDph     @default(STANDARD)
  jazyk    JazykDokladu @default(CS)

  status          InvoiceStatus @default(DRAFT)
  sentAt          DateTime?
  paidAt          DateTime?
  paidAmountMinor Int?

  // Faktura muze vzniknout z odsouhlasene nabidky - polozky se prenesou.
  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id])

  items InvoiceItem[]

  /// Pohyby na uctu, ktere k teto fakture portal priradil (17. 9. 2026).
  bankTransactions BankTransaction[]

  // Vazba na projekt v Caflou (zadani 8. 9. 2026: "chtel bych mit Doklady
  // navazane na projekty"). Nazev drzime i textove, aby doklad zustal
  // citelny, kdyz projekt v Caflou zmizi nebo se prejmenuje.
  caflouProjectId String?
  projectName     String?

  /// SLEVA NA CELEM DOKLADU (zadani 14. 9. 2026: „potrebuju u nabidek
  /// a faktur mit moznost pridat nejakou slevu").
  ///
  /// Bud procenta, nebo pevna castka - obe naraz nedavaji smysl, takze plati
  /// procenta, kdyz jsou vyplnena. Sleva je VZDY BEZ DPH a rozpocita se mezi
  /// sazby podle jejich podilu na zaklade; jinak by u dokladu se dvema
  /// sazbami neseldila odvedena dan.
  slevaProcent Float   @default(0)
  slevaMinor   Int     @default(0)
  /// Co se na dokladu vytiskne vedle slevy, napr. „Sleva za objem".
  slevaPopis   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Komu a kdy faktura odesla (zadani 15. 9. 2026: „a zaznam nekde o tom,
  /// kdy a na koho ta faktura sla").
  odeslani OdeslaniFaktury[]

  @@index([companyId])
  @@index([status])
  @@index([caflouProjectId])
  @@index([offerId])
}

/// JEDNO ODESLANI FAKTURY (zadani 15. 9. 2026). Faktura se posila i vickrat -
/// klient ji nenajde, ucetni chce kopii - a pak se hodi vedet, kdy a komu
/// presne odesla. Samotne `sentAt` na fakture rekne jen to posledni.
model OdeslaniFaktury {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Adresy, na ktere mail odesel - prvni je hlavni prijemce, zbytek kopie.
  prijemci String[]
  /// Kdo odeslani spustil.
  odeslalId    String?
  odeslalJmeno String?
  /// Sla s mailem i priloha (PDF faktury, pripadne rodny list)?
  sPrilohou    Boolean @default(false)
  sRodnymListem Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String
  quantity       Float   @default(1)
  unit           String?
  unitPriceMinor Int     @default(0) // cena za jednotku bez DPH, v halerich/centech
  vatRate        Int     @default(21)
  sortOrder      Int     @default(0)

  @@index([invoiceId])
}


// ===========================================================================
// VYDAJE (zadani 6. 9. 2026) - prijate doklady od dodavatelu, vcetne smluv s
// herci a drobnych dokladu.
// ===========================================================================

// Kategorie vydaju. Zamerne ciselnik v databazi, ne pevny vycet - uzivatel si
// potrebuje pridavat dalsi podle skutecnych dokladu (zadani 8. 9. 2026:
// "u vydaju bych chtel mit moznost pridavat dodatecne kategorie").
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true) // vyrazena se uz nenabizi u novych dokladu
  expenses  Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id     String  @id @default(cuid())
  number String? // cislo dokladu od dodavatele

  // Dodavatel: bud firma ze sekce Firmy, nebo jen jmeno u drobneho dokladu
  // (benzin, parkovne) - proto obojí a nic z toho povinne.
  supplierCompanyId String?
  supplier          Company? @relation(fields: [supplierCompanyId], references: [id])
  supplierName      String?

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])

  // Za kterou nasi firmu vydaj jde.
  issuerCompanyId String?
  issuer          IssuerCompany? @relation(fields: [issuerCompanyId], references: [id])

  currency         Currency  @default(CZK)
  exchangeRate     Float     @default(1) // kurz CNB ke dni dokladu
  exchangeRateDate DateTime?

  description String?
  // Castka se zadava BEZ DPH; sazba 0 znamena bez DPH (herci nejsou vzdy
  // platci a sazby nejsou vzdy 21 %).
  amountExVatMinor Int @default(0)
  vatRate          Int @default(21)

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paid      Boolean   @default(false)
  paidAt    DateTime?

  // Prevodem je vychozi stav: drtiva vetsina starsich dokladu jsou faktury.
  paymentMethod PaymentMethod @default(TRANSFER)

  // Priloha - PDF nebo foto uctenky.
  attachmentUrl  String?
  attachmentName String?

  // Ucet prijemce, kdyz ho neni kde vzit (herec nema firmu ze sekce Firmy).
  // Z nej se kresli QR platba (zadani 15. 9. 2026).
  supplierAccount String?

  note String?

  // Vazba na projekt v Caflou (zadani 8. 9. 2026: "chtel bych mit Doklady
  // navazane na projekty"). Nazev drzime i textove, aby doklad zustal
  // citelny, kdyz projekt v Caflou zmizi nebo se prejmenuje.
  caflouProjectId String?
  projectName     String?

  // ODKUD DOKLAD PRISEL (zadani 12. 9. 2026: faktury chodi na
  // uctarna@mediaspace.cz, maji se v portalu objevit jako nezarazene).
  // Doklad ze schranky ceka na ucetni: ta ho prekontroluje, doplni kategorii
  // a teprve tim se zaradi mezi vydaje. Do souctu a do zalozek Uhrazene /
  // Neuhrazene se proto pocitaji jen ZARAZENY doklady.
  stav  StavDokladu @default(ZARAZENY)
  zdroj String? // "MAIL" u dokladu ze schranky, jinak prazdne (zadano rucne)

  // Klic proti dvojimu zalozeni: id zpravy a poradi prilohy v ni. Schranka se
  // cte opakovane a zprava se z ni nemaze.
  mailKlic      String?   @unique
  mailOd        String?
  mailPredmet   String?
  mailPrijatoAt DateTime?

  // Co se z prilohy podarilo vycist (vcetne jistoty), aby sla ucetni ukazat
  // i ta pole, ktera uz mezitim prepsala.
  navrhJson String?

  /// Dalsi prilohy k dokladu (zadani 21. 9. 2026: „zpetne upravovat vydaje
  /// a pridavat prilohy"). Hlavni priloha zustava v attachmentUrl - cte se
  /// z ni a ukazuje se v nahledu; tady je vsechno ostatni.
  prilohy PrilohaVydaje[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paid])
  @@index([categoryId])
  @@index([caflouProjectId])
  @@index([stav])
}

/// Dalsi priloha vydaje (21. 9. 2026). url je adresa v ulozisti nebo data URL.
model PrilohaVydaje {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  nazev     String
  createdAt DateTime @default(now())

  @@index([expenseId])
}

/// Doklad ze schranky ceka na prekontrolovani, rucne zadany uz je zarazeny.
enum StavDokladu {
  NEZARAZENY
  ZARAZENY
}

/// Kam az je precteny postovni ucet s doklady. Jediny radek (id "posta").
model PostaStav {
  id String @id @default("posta")

  // Posledni precteny UID zpravy. IMAP UID v ramci slozky jen roste, takze
  // staci pamatovat si nejvyssi zpracovany - nic se necte dvakrat a nic se
  // ve schrance nemusi mazat ani oznacovat.
  posledniUid Int @default(0)

  posledniKontrolaAt DateTime?
  posledniChyba      String?
  nactenoCelkem      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Vlastni nazvy sloupcu v tabulkach (zadani 8. 9. 2026: "dej tam ty tri tecky
// jako v menu na upravu tech nazvu sloupcu"). Ulozene je jen to, co si
// uzivatel prejmenoval - zbytek se bere z vychozich nazvu v kodu
// (src/lib/columnLabels.ts), takze pribyvajici sloupce fungujou samy.
model ColumnLabel {
  id        String @id @default(cuid())
  tableKey  String // ktera tabulka, napr. "projekty-interni"
  columnKey String // ktery sloupec, napr. "managerName"
  /// Vlastni nazev sloupce. Prazdny retezec = ponechat vychozi nazev z kodu -
  /// diky tomu se pozdejsi zmena vychoziho nazvu porad projevi.
  label     String

  /// Poradi a skryti (rozsireni 9. 9. 2026 - "udelejme to stejne jako
  /// v hlavnim menu": pretahovani a odebrani krizkem).
  sortOrder Int     @default(0)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tableKey, columnKey])
  @@index([tableKey])
}


// ===========================================================================
// SMLOUVY S ELEKTRONICKYM PODPISEM (zadani 8. 9. 2026: "chtel bych udelat
// vlastni podepisovani smluv, jak to ma treba Signi. Ale bez kodu
// potvrzovacich.")
//
// Identita podepisujiciho se overuje jednorazovym odkazem poslanym na jeho
// e-mail - zadna SMS ani overovaci kod. Ke kazdemu podpisu se uklada
// dolozka: kdy, z jake IP, z jakeho prohlizece a OTISK textu, ktery clovek
// videl. Kdyby se text smlouvy pozdeji zmenil, otisk prestane sedet a je to
// poznat. Podle eIDAS jde o prosty elektronicky podpis.
// ===========================================================================

enum ContractStatus {
  DRAFT     // rozpracovaná - jde měnit text
  SENT      // odeslaná, čeká na podpis protistrany
  SIGNED    // podepsaná oběma stranami
  REJECTED  // protistrana podpis odmítla
  CANCELLED // zrušená námi
}

enum ContractSignerRole {
  MEDIASPACE   // naše strana - podepisuje se v portálu
  PROTISTRANA  // herec / klient - podepisuje přes odkaz
}

/// Šablona smlouvy s poli {{jmeno}}, {{projekt}}… - viz lib/contracts.ts.
/// SMLOUVA OD KLIENTA - archiv (zadani 21. 9. 2026: „potrebuju nekam do
/// dokladu projektu nahrat smlouvu v PDF, kterou nam posila k podpisu klient na
/// praci. Ve chvili, kdy ji vkladam, uz je podepsana, chci ji jen archivovat.
/// A taky tam chci nejake tlacitko, kdyz ji tam Karolina vlozi, tak ho zmackne
/// a Bruno napise treba soukrome do chatu Bare Siblove, ze je tam podepsana
/// smlouva").
///
/// Neni to Contract (ta se u nas pise a podepisuje v portalu) - tohle je
/// hotove PDF od klienta, jen ulozene k projektu.
model SmlouvaKlienta {
  id              String    @id @default(cuid())
  caflouProjectId String
  /// Popis, jak ho clovek napsal (vychozi = nazev souboru).
  nazev           String
  /// Klic v ulozisti (R2) - soubor jde primo z prohlizece, viz podepsanyUploadSmlouvy.
  souborKlic      String
  nazevSouboru    String
  velikost        Int?
  /// Kdy klient smlouvu podepsal - nepovinne.
  podepsanoDne    DateTime?
  nahralUserId    String?
  nahralJmeno     String?
  /// Bruno o ni dal vedet (komu a kdy) - tlacitko se pak zmeni na potvrzeni.
  oznamenoAt      DateTime?
  oznamenoKomu    String?
  createdAt       DateTime  @default(now())

  @@index([caflouProjectId])
}

model ContractTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  body      String   @db.Text
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id     String @id @default(cuid())
  number String @unique
  title  String

  /// Finální text smlouvy - šablona s už doplněnými poli, dál ručně upravitelná.
  body String @db.Text

  issuerCompanyId String
  issuer          IssuerCompany @relation(fields: [issuerCompanyId], references: [id])

  /// Protistrana: firma ze sekce Firmy (nepovinná - herec firmu mít nemusí).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Komu odkaz k podpisu jde. Jméno i e-mail se drží textově.
  signerName  String
  signerEmail String

  caflouProjectId String?
  projectName     String?

  status ContractStatus @default(DRAFT)

  /// Jednorázový odkaz k podpisu - stejný princip jako u nabídek.
  accessToken String @unique

  sentAt         DateTime?
  completedAt    DateTime?
  rejectedAt     DateTime?
  rejectedReason String?

  /// Otisk textu v okamžiku odeslání k podpisu.
  bodyHash String?

  /// Odměna tak, jak ji člověk zadal při zakládání - z ní vzniká výdaj po podpisu.
  odmenaText String?

  /// Splatnost ze zakládacího formuláře (ve dnech) - výdaj z ní dopočítá datum splatnosti.
  splatnostText String?

  /// Herec z projektu, pro kterého smlouva je - z jeho karty se bere účet na QR platbu.
  actorUserId String?

  /// Výdaj založený po podpisu smlouvy (zadání 15. 9. 2026), ať nevznikne podruhé.
  vydajId String? @unique

  signatures ContractSignature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([caflouProjectId])
  @@index([companyId])
}

model ContractSignature {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  role  ContractSignerRole
  name  String
  email String?

  /// Nakreslený podpis jako PNG v data URL.
  imageData String @db.Text

  signedAt     DateTime @default(now())
  ip           String?
  userAgent    String?
  /// Otisk textu, který podepisující v tu chvíli viděl.
  documentHash String

  /// Kolik stranek smlouva mela a kolik jich podepisujici odklikal (zadani
  /// 13. 9. 2026). Stranky nejsou v textu nijak vyznacene - pocita je
  /// lib/smlouvaStranky.ts deterministicky z tela, takze se daji kdykoliv
  /// spocitat znovu a overit, co presne clovek videl.
  ///
  /// Volitelne kvuli podpisum, ktere vznikly driv, nez strankovani existovalo.
  stranekCelkem    Int?
  stranekPotvrzeno Int?

  @@index([contractId])
}


// ===========================================================================
// KALENDARE STUDII A NATACECI FREKVENCE (zadani 8. 9. 2026)
//
// Produkcni vytvori hercovi NABIDKU terminu, herec si z ni vybere presne
// tolik, kolik je potreba frekvenci, a produkcni vyber potvrdi. Teprve tim
// vznika pevna rezervace studia.
//
// Obsazenost studia drzi JEDNA tabulka - RecordingSlot ve stavu SELECTED
// (drzeno do schvaleni) nebo CONFIRMED, plus StudioBlock. Zadna paralelni
// evidence rezervaci, aby se dve kopie nemohly rozejit.
//
// Projekt zije v Caflou, takze se sem - stejne jako u ProjectMeta, vykazu,
// dokladu a smluv - klicuje pres textove caflouProjectId.
// ===========================================================================

/// Kalendarovy zdroj. Dnes jedno studio = jeden kalendar; az budou mistnosti,
/// bude mistnost studio s vyplnenym parentStudioId (relace nize).
model Studio {
  id             String  @id @default(cuid())
  name           String  @unique
  shortName      String
  location       String?
  /// Barva udalosti v kalendari.
  color          String  @default("#7B55FF")
  /// London ma jine pasmo nez Brno - proto u kazdeho studia zvlast.
  timezone       String  @default("Europe/Prague")
  sortOrder      Int     @default(0)
  active         Boolean @default(true)

  /// ODKAZ NA VIDEOHOVOR STUDIA (zadani 23. 9. 2026: „posilam odkazy na
  /// videohovory. Mohly by se ulozit nekam ke studiim. I by mohl byt proklik
  /// rovnou z toho kalendare"). V kalendari z nej je ikona rezie na dalku,
  /// cely odkaz nikde nesviti.
  hovorOdkaz     String?

  parentStudioId String?
  parentStudio   Studio?  @relation("StudioRooms", fields: [parentStudioId], references: [id])
  rooms          Studio[] @relation("StudioRooms")

  hours    StudioHours[]
  presets  StudioSlotPreset[]
  blocks   StudioBlock[]
  requests RecordingRequest[]
  slots    RecordingSlot[]
  feeds    CalendarFeed[]
  /// Zvukari, kteri v tomhle studiu tocí (zadani 20. 9. 2026).
  zvukari  User[] @relation("ZvukarStudia")
  /// Vedouci pobocky - smi upravovat kalendar tohoto studia (22. 9. 2026).
  vedouci  User[] @relation("VedouciStudia")
  /// Lide z tymu, kteri si smi otevrit tabuli tohoto studia (23. 9. 2026).
  tabuleLide User[] @relation("TabulePristup")
  /// Účty počítačů u obrazovky (role TABULE), viz User.tabuleStudioId.
  tabuleUcty User[] @relation("TabuleUcet")

  /// TABULE VE STUDIU (zadani 21. 9. 2026). Tajny klic v adrese
  /// /tabule/<klic> - dotykovy displej se neprihlasuje. Null = tabule vypnuta.
  tabuleKlic      String?          @unique
  /// Okno s příběhy z Instagramu na tabuli (22. 9. 2026) - dá se u studia vypnout.
  tabuleInstagram Boolean          @default(true)
  tabulePoznamky  StudioPoznamka[]
  tabuleChybi     StudioChybi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Poznamka na tabuli ve studiu (21. 9. 2026). Zustava, dokud ji nekdo
/// neodskrtne (hotovoAt).
model StudioPoznamka {
  id        String    @id @default(cuid())
  studioId  String
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  text      String    @db.Text
  autor     String?
  createdAt DateTime  @default(now())
  hotovoAt  DateTime?

  @@index([studioId, hotovoAt])
}

/// Co ve studiu chybi (kava, toaletak...) - nahlaseno na tabuli ťuknutim.
/// Aktivni = doplnenoAt je null. Klic polozky viz POLOZKY_TABULE v lib/tabule.ts.
model StudioChybi {
  id          String    @id @default(cuid())
  studioId    String
  studio      Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  polozka     String
  nahlasenoAt DateTime  @default(now())
  doplnenoAt  DateTime?

  @@index([studioId, doplnenoAt])
}

/// Pracovni doba studia po dnech v tydnu. Minuty od pulnoci, at se s tim da
/// pocitat bez tahani casovych pasem do databaze.
model StudioHours {
  id            String  @id @default(cuid())
  studioId      String
  studio        Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  /// 0 = nedele, 1 = pondeli … 6 = sobota (stejne jako Date.getDay()).
  weekday       Int
  startMinutes  Int
  endMinutes    Int
  /// Vikend: natacet jde, ale jen po domluve se zvukarem - kalendar to jen
  /// oznaci, neblokuje (zadani 8. 9. 2026).
  byArrangement Boolean @default(false)

  @@unique([studioId, weekday])
}

/// Nejcastejsi frekvence (9-13, 13-17) jako zkratka na jedno kliknuti.
/// Neomezuje - produkcni si muze vytahnout libovolne okno, treba 8-12.
model StudioSlotPreset {
  id           String @id @default(cuid())
  studioId     String
  studio       Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  label        String
  startMinutes Int
  endMinutes   Int
  sortOrder    Int    @default(0)
}

enum StudioBlockKind {
  HOLIDAY     // statni svatek
  VACATION    // dovolena
  MAINTENANCE // udrzba, servis techniky
  INTERNAL    // interni blokace
  OTHER
  // Rucne zapsana prace ve studiu (zadani 14. 9. 2026: "kdyz otevru kalendar
  // z hlavniho panelu, tak chci pridat rucne udalost"). Neni to nabidka
  // terminu herci - ta se porad zaklada tlacitkem v detailu projektu.
  NATACENI    // natáčení s hercem
  STRIH       // střih
  CASTING     // casting (zadani 20. 9. 2026 - treti druh prace)
}

/// Cas, kdy se ve studiu netoci. Do obsazenosti se pocita stejne jako
/// potvrzena rezervace.
model StudioBlock {
  id       String          @id @default(cuid())
  studioId String
  studio   Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  start    DateTime
  end      DateTime
  kind     StudioBlockKind @default(INTERNAL)
  title    String
  note     String?

  // --- Rucne zapsana udalost (zadani 14. 9. 2026) ---
  // Vyplnuje se jen u kind NATACENI / STRIH. Jmena se ukladaji jako OTISK
  // vedle id: ucet muze zaniknout nebo se prejmenovat a zaznam v kalendari
  // ma zustat citelny - stejne jako u nabidek terminu a smluv.
  // Zamerne BEZ vazby na User: kalendar si z uctu nic nedotahuje, jen
  // zobrazuje, co se zapsalo.
  /// Projekt, ke kteremu udalost patri (ProjectMeta.caflouProjectId).
  caflouProjectId String?
  projectName     String?
  /// Herec - jen u natáčení, u střihu zustava prazdny.
  actorUserId     String?
  actorName       String?
  /// REŽIE ONLINE (zadani 23. 9. 2026) - stejne jako u RecordingSlot.
  rezieOnline     Boolean?
  zvukarUserId    String?
  zvukarName      String?

  createdById String?
  createdBy   User?   @relation("StudioBlockCreatedBy", fields: [createdById], references: [id])

  /// Klic udalosti prevzate ze stareho Google kalendare (zadani 20. 9. 2026).
  /// Seed podle nej udalost zaklada jen jednou a opravu v datech prepise.
  /// Rucne zapsane udalosti ho nemaji.
  importKlic String? @unique

  /// Upraveno v portálu (21. 9. 2026: „u střihu nevidíme název projektu").
  /// Převzaté události se při každém nasazení srovnávají s daty z Googlu -
  /// bez tohohle by doplněný projekt, přesunutý čas nebo jiný zvukař
  /// s dalším nasazením tiše zmizely. Co tým jednou upravil, seed nechá být.
  upravenoVPortalu Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, start, end])
}

/// Převzatá událost z Google kalendáře, kterou tým v portálu SMAZAL
/// (21. 9. 2026). Seed ji podle klíče jinak při dalším nasazení založil znovu.
model SmazanyImport {
  importKlic String   @id
  smazano    DateTime @default(now())
}

enum RecordingStatus {
  DRAFT     // koncept - zalozeno z projektove karty, jeste bez terminu
  PREPARING // produkcni vybira okna v kalendari
  SENT      // nabidka odeslana herci
  PICKING   // herec odkaz otevrel a vybira
  SUBMITTED // vyber odeslan ke schvaleni, terminy drzeny do holdUntil
  RETURNED  // vraceno herci k prepracovani
  REJECTED  // zamitnuto
  CONFIRMED // potvrzeno - schvaleni a potvrzeni je jeden krok (zadani 8. 9. 2026)
  CANCELLED // zruseno
  COMPLETED // odtoceno
}

enum SlotState {
  OFFERED   // nabidnuto herci
  SELECTED  // herec vybral, drzi se do rozhodnuti produkce
  CONFIRMED // pevna rezervace
  RELEASED  // nevybrano, vraceno nebo vyprselo drzeni
  CANCELLED // zruseno po potvrzeni
}

/// Nabidka terminu pro jednoho herce na jednom projektu. Kniha delena mezi
/// vic hercu ma vic nabidek, kazdou se svym poctem normostran (zadani
/// 8. 9. 2026).
model RecordingRequest {
  id              String @id @default(cuid())
  caflouProjectId String
  /// Otisk nazvu projektu, aby zaznam zustal citelny i bez Caflou.
  projectName     String

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  actorUserId String?
  actor       User?   @relation("RecordingActor", fields: [actorUserId], references: [id])
  /// Otisk jmena a e-mailu - herec muze zmenit ucet, nabidka ma zustat citelna.
  actorName   String
  actorEmail  String

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])
  /// Zaskrtnuta studia, do kterych se nabizi (zadani 19. 9. 2026: „asi by to
  /// tam chtelo zaskrtavaci pole"). Prazdne = studio nabidky a vsechna
  /// studia ve stejnem meste.
  nabizenaStudia String[] @default([])

  /// Normostrany pro TOHOTO herce. Predvyplni se z projektu, da se prepsat.
  pageCount        Int?
  /// Kolik terminu musi herec vybrat. Uklada se natvrdo - pozdejsi zmena
  /// normostran v Caflou nesmi zpetne prepsat, na co se herec dival.
  requiredSessions Int
  sessionMinutes   Int @default(240)

  periodFrom DateTime
  periodTo   DateTime

  note         String? // poznamka produkce pro herce
  actorNote    String? // poznamka herce k vyberu
  decisionNote String? // duvod vraceni nebo zamitnuti

  status RecordingStatus @default(DRAFT)
  /// Jednorazovy odkaz k vyberu - stejny princip jako u nabidek a smluv.
  accessToken String @unique
  /// Do kdy se drzi vybrane terminy (BudgetSettings.holdHours).
  holdUntil   DateTime?

  createdById String
  createdBy   User   @relation("RecordingCreatedBy", fields: [createdById], references: [id])

  sentAt      DateTime?
  openedAt    DateTime?
  submittedAt DateTime?
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("RecordingDecidedBy", fields: [decidedById], references: [id])
  completedAt DateTime?

  slots  RecordingSlot[]
  events RecordingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caflouProjectId])
  @@index([status])
  @@index([actorUserId])
}

/// Jedno casove okno. studioId je tu i pres request zamerne - dotaz na
/// obsazenost studia se pak obejde bez joinu.
model RecordingSlot {
  id        String           @id @default(cuid())
  requestId String
  request   RecordingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  start DateTime
  end   DateTime

  state      SlotState @default(OFFERED)
  selectedAt DateTime?
  /// Poznamka / vzkaz k frekvenci. V nabidce taky znacka mista
  /// ("Víkend – po domluvě", "Návrh herce").
  note       String?

  /// REŽIE ONLINE (zadani 23. 9. 2026). null = pocita se samo (prvni
  /// frekvence daneho herce na danem projektu ji ma), true / false = rucni
  /// vyjimka zaskrtnuta v kalendari. Viz lib/rezieOnline.ts.
  rezieOnline Boolean?

  /// Zvukar potvrzene frekvence - doplnuje se v kalendari dvojklikem
  /// (zadani 19. 9. 2026: „aby pak šly dvojklikem editovat a šlo by přidat
  /// zvukaře a změnit studio i čas").
  zvukarUserId String?
  zvukarName   String?

  /// PŘEBOOKOVÁNÍ HERCEM ZA TERMÍN ODEVZDÁNÍ (zadání 19. 9. 2026: „jakmile to
  /// bude mimo datum, tak to půjde, ale musí mu tam vyskočit hláška, že to
  /// musíme potvrdit"). Termín zůstává, kde byl, dokud produkce žádost
  /// nepotvrdí - tady je jen to, kam se chce herec přesunout.
  prebookStart    DateTime?
  prebookEnd      DateTime?
  prebookStudioId String?
  prebookAt       DateTime?

  events RecordingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, start, end])
  @@index([requestId, state])
}

/// Historie: kdo co kdy udelal. Herec bez uctu ma userId null a jmeno
/// v actorLabel.
model RecordingEvent {
  id        String           @id @default(cuid())
  requestId String
  request   RecordingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  slotId String?
  slot   RecordingSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  userId     String?
  user       User?   @relation("RecordingEventUser", fields: [userId], references: [id])
  actorLabel String

  type       String
  fromStatus String?
  toStatus   String?
  note       String?
  /// Puvodni a novy cas u presunu, seznam terminu u vyberu apod.
  payload    Json?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

/// Notifikace v portalu. Zamerne obecna - pouzitelna i pro doklady a smlouvy,
/// a pozdeji pro push do mobilu (pribude jen odesilaci kanal, ne novy model).
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  String
  title String
  body  String?
  url   String?

  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum FeedScope {
  MINE   // jen moje terminy
  STUDIO // cely kalendar jednoho studia
  ALL    // vsechna studia
  MIMO   // jen Mimo studio (20. 9. 2026 - kazdy kalendar zvlast)
  PORADY // jen porady, na kterych je vlastnik odkazu (21. 9. 2026)
}

/// Osobni ICS odkaz. Nahodny, odvolatelny, filtruje se podle prav vlastnika -
/// nikdy nesmi pustit k cizim projektum.
model CalendarFeed {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique
  scope FeedScope @default(MINE)

  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id])

  revokedAt  DateTime?
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Vygenerovaný Rodný list (RL) reklamního spotu - zadání 9. 9. 2026.
///
/// Údaje se ukládají i textově: dokument musí zůstat doložitelný i potom, co
/// se projekt v Caflou přejmenuje nebo firma změní název. Vazba na projekt je
/// přes textové ID z Caflou, stejně jako u dokladů a natáčecích frekvencí.
model RodnyList {
  id String @id @default(cuid())

  caflouProjectId String
  projectName     String
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])

  /// Pořadí verze. Automatika další verzi nikdy nedělá - vzniká jen řízeně
  /// tlačítkem "Vygenerovat RL znovu", aby refresh stránky nedělal duplicity.
  version  Int
  fileName String

  /// Odkaz na PDF: adresa v S3/R2, nebo data URL, když úložiště není nastavené
  /// (stejný princip jako u příloh výdajů - viz lib/storage.ts).
  url String @db.Text

  /// Kopie na Google Disku, pokud se ji podařilo nahrát.
  driveFileId String?
  driveUrl    String?

  /// Proč kopie na Disku není (oprava 10. 9. 2026: "vygeneroval jsem nový RL,
  /// ale neuložil se do složky projektu"). Dřív se selhání jen zapsalo do
  /// logu serveru, takže v portálu nebylo poznat, jestli se nahrání vůbec
  /// zkoušelo. Prázdno u řádku s driveUrl znamená, že je všechno v pořádku.
  driveError String?

  /// Hodnoty tak, jak jsou vytištěné v dokumentu.
  clientName     String
  spotName       String
  spotLength     String
  director       String
  musicTitle     String?
  musicAuthor    String?
  productionDate DateTime

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([caflouProjectId, version])
  @@index([caflouProjectId])
  @@index([companyId])
}

/// Sdílená cache seznamu projektů z Caflou - oprava 9. 9. 2026.
///
/// Interní přehled projektů si celý účet Caflou stahuje po stovkách, tedy
/// osmi dotazy za sebou; naměřeno 12,5 s. Cache byla dosud jen v paměti jedné
/// instance funkce na Vercelu, takže jakmile požadavek obsloužila jiná (což je
/// běžné), platilo se to znovu. Tahle tabulka je společná pro všechny - první
/// požadavek po vypršení platnosti seznam stáhne a uloží sem, ostatní ho čtou
/// jedním dotazem.
///
/// Je to opravdu jen cache: když řádek chybí nebo je starý, nic se nerozbije,
/// jen se sáhne do Caflou.
model CaflouProjectsCache {
  /// Zatím jediný klíč "internal-projects"; sloupec je tu pro další seznamy.
  key String @id

  /// Namapované projekty jako JSON (viz AdminDisplayProject v lib/caflou.ts).
  payload String @db.Text
  /// Kolik projektů payload obsahuje - kvůli přehledu v diagnostice.
  count Int

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ===========================================================================
// PREPOSLECH NAHRAVKY (AudioTagger) - zadani 11. 9. 2026.
//
// Prevzato z prototypu (viz projektovy dokument audiotagger-v1-prototype.md),
// ktery si zaznamy chyb drzel jen v prohlizeci. Tady uz patri projektu:
// prezijou obnoveni stranky i vymenu pocitace a vidi je cely tym.
//
// Stopy samotne se v databazi NEDRZI - jsou to soubory, ktere si clovek
// vybere z disku. Zaznam proto ukazuje na stopu jejim PORADIM (od 1) a nese
// i jeji nazev, aby byl citelny i ve chvili, kdy zadne soubory nactene
// nejsou. Z poradi se dopocitava i pozice na casove ose Cubase
// (offset = (poradi - 1) x 3600 s).
// ===========================================================================

model PreposlechChyba {
  id              String @id @default(cuid())
  caflouProjectId String

  /// Poradi stopy od 1 - z nej se pocita offset na casove ose Cubase.
  trackIndex Int
  /// Nazev souboru stopy, aby byl zaznam citelny i bez nactenych souboru.
  trackName  String
  /// Cas v ramci stopy, v sekundach od jejiho zacatku.
  localTime  Float
  /// Strana PDF, na ktere chyba je (kdyz bylo PDF nactene).
  pdfPage    Int?
  /// Zvyrazneny usek textu (zadani 11. 9. 2026) - { strana, ramecky, text }.
  /// Ramecky jsou ZLOMKY sirky a vysky strany (0-1), ne pixely: PDF se
  /// vykresluje na sirku okna, takze v pixelech by zvyrazneni sedelo jen
  /// pri stejne sirke, v jake vzniklo.
  zvyrazneni Json?

  description String @db.Text

  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())

  @@index([caflouProjectId, trackIndex, localTime])
}

/// PRIPOMINKY KLIENTA K VIDEU (zadani 18. 9. 2026: „chci mit u klientu,
/// kterym delame reklamu, modifikovany AudioTagger… po kliknuti se otevre
/// modifikovany audiotagger pro reklamy, kde bude video v nahledu, pod nim
/// bude vykreslena zvukova stopa a napravo se budou taggovat pripominky").
///
/// ZAMERNE VLASTNI MODEL, ne PreposlechChyba. U audioknihy jsou to nase
/// poznamky ke stopam, ktere si zapisuje zvukar; tohle pisou KLIENTI k jednomu
/// konkretnimu videu na Disku a nemaji nic spolecneho s poradim stop ani
/// s casovou osou Cubase. Michat to dohromady by znamenalo, ze se v prehledu
/// chyb objevi cizi text - a naopak.
///
/// Soubor se drzi jeho ID na Disku: klient si odkaz preposle a video se
/// mezitim muze prejmenovat, ale ID zustava.
model ReklamaPripominka {
  id              String @id @default(cuid())
  caflouProjectId String

  /// ID souboru na Google Disku, ke kteremu pripominka patri.
  driveFileId   String
  /// Nazev v dobe zapisu - at je zaznam citelny i po prejmenovani.
  driveFileName String

  /// Cas ve videu v sekundach od zacatku.
  cas  Float
  text String @db.Text

  /// Kdo to napsal. Klient z odkazu ucet nema, proto jen jmeno.
  autorJmeno  String?
  autorUserId String?

  /// Odskrtnuto na nasi strane - „tohle uz je opravene".
  vyrizeno   Boolean  @default(false)
  /// Kdy klient stiskl „Odeslat pripominky" (upresneni 18. 9. 2026: „pak tam
  /// bude jen tlacitko odeslat pripominky"). Dokud je prazdne, klient si je
  /// jeste rozmysli - zapsane uz jsou, ale nikoho neupozornuji.
  odeslanoAt DateTime?
  createdAt  DateTime @default(now())

  @@index([caflouProjectId, driveFileId, cas])
}

/// Stav preposlechu celeho projektu - tlacitko PREPOSLECHNUTO z prototypu.
model PreposlechStav {
  caflouProjectId String    @id
  reviewed        Boolean   @default(false)
  reviewedAt      DateTime?
  reviewedByName  String?

  /// Kolik stop ma AudioTagger u projektu k dispozici (zadani 12. 9. 2026:
  /// sloupec „K preposlechu" u klienta). Zapisuje se pri kazdem nacteni stop
  /// - slozka na Disku je zdroj pravdy, tohle je jen jeji posledni znama
  /// podoba. Do seznamu projektu se nesaha na Disk: u padesati projektu by to
  /// znamenalo padesat dotazu do Google API pri kazdem otevreni prehledu.
  pocetStop       Int       @default(0)
  stopyZjistenyAt DateTime?

  /// Pocet stran PDF s textem (zadani 19. 9. 2026: „Progres nataceni ma
  /// pocitat strany v PDF versus zapis stranky, na ktere se skoncilo").
  /// Drzi se k ID souboru na Disku - kdyz se text vymeni, pocita se znovu.
  textSouborId    String?
  textStran       Int?
  textStranAt     DateTime?

  /// Strany PDF, ktere klient PRI PREHRAVANI mel pred ocima (zadani
  /// 21. 9. 2026: „potreboval bych, aby se mu ukazovaly procenta, kolik ma
  /// preposlechnuto. Ale tracky tam vetsinou davame po kouskach. Takze by to
  /// melo brat asi informace z pdf"). Podil techto stran z celku = procento
  /// preposlechu. Pocita se jen poslech klienta, ne nas.
  slyseneStrany   Int[]     @default([])
  /// Kolik stran melo PDF, kdyz se strany pocitaly naposledy.
  slyseneStranyZ  Int?
  /// Pri kolika stopach dostali posluchaci naposledy zpravu o novych
  /// trackach (21. 9. 2026). Kdyz je jich na Disku vic, poslou se znovu.
  oznamenoStop    Int?

  updatedAt       DateTime  @updatedAt
}

/// Jedna preposlechnuta stopa (zadani 12. 9. 2026: „Preposlechnuto - tam bude
/// pocet tracku a kolik je z nich preposlechnuto, treba 3 z 24").
///
/// Zapise se SAMA, kdyz prehravani dojede na konec stopy - klient nic
/// neodskrtava. Stopa se pozna poradim, stejne jako u zaznamu chyb, a nese
/// i svuj nazev, aby byl radek citelny i bez nactenych stop.
model PreposlechStopa {
  id              String   @id @default(cuid())
  caflouProjectId String
  trackIndex      Int
  trackName       String
  poslechnutoAt   DateTime @default(now())
  /// Kdo dojel na konec - u tokenu „Klient", jinak jmeno z uctu.
  kdo             String?

  /// „Tenhle track mam hotovy" - RUCNI zaskrtnuti preposlouchavace
  /// (zadani 14. 9. 2026). Neplete se s poslechnutoAt: to se zapise samo,
  /// kdyz prehravani dojede na konec. Doposlechnout stopu a mit ji vyrizenou
  /// jsou dve ruzne veci - clovek si ji muze pustit celou a stejne se k ni
  /// jeste vracet.
  hotovoAt        DateTime?
  hotovoKdo       String?

  @@unique([caflouProjectId, trackIndex])
  @@index([caflouProjectId])
}

/// Kdo posloucha projekt odkazem (zadani 21. 9. 2026: „aby vyskocilo po
/// kliknuti na odkaz AudioTaggeru okno, kde se zada mail, kvuli identifikaci.
/// Primarne asi mail, na ktery se to posle + kdyz chci nekomu delegovat
/// preposlech ... Tem lidem pak nastavime podle mailu i notifikace, ze tam
/// pribyly nove tracky").
///
/// Odkaz je porad jeden na projekt; tohle je seznam lidi, kteri ho pouzivaji.
/// Prohlizec si pamatuje, kdo z nich u nej sedi (cookie), a podle toho se
/// podepisuji poznamky a zapisuje historie - „aby tam byl zaznam o tom, kdo
/// co udelal".
model PreposlechPosluchac {
  id              String   @id @default(cuid())
  caflouProjectId String
  email           String
  jmeno           String?
  /// Chodi mu zpravy o novych trackach.
  notifikace      Boolean  @default(true)
  /// Kdo ho pridal - jmeno textem.
  pridal          String?
  createdAt       DateTime @default(now())

  @@unique([caflouProjectId, email])
  @@index([caflouProjectId])
}

/// Odkaz na celoobrazovkovy preposlech pro klienta (zadani 11. 9. 2026:
/// „proste mu posleme odkaz, pobezi to na portalu ale ve fullscreen,
/// klient vlastne ani nebude vedet, kde je").
///
/// Klient nema ucet a mit ho nemusi - do AudioTaggeru se dostane tokenem
/// z mailu. Na projekt je zivy vzdycky jeden odkaz; „Vygenerovat novy"
/// ten predchozi zneplatni, coz je zaroven jediny zpusob, jak uz rozeslany
/// odkaz zavrit.
model PreposlechOdkaz {
  token           String @id
  caflouProjectId String @unique

  createdAt     DateTime  @default(now())
  createdByName String?
  /// Vyplneno = odkaz uz neplati (vygenerovali jsme novy nebo jsme ho zavreli).
  zneplatnenoAt DateTime?

  /// Kdy si ho klient naposledy otevrel a kolikrat - at je videt, jestli poslouchal.
  otevrenoAt    DateTime?
  pocetOtevreni Int       @default(0)
}


/// Dotoceny herec na projektu (zadani 11. 9. 2026: "u hercu v projektech
/// v detailu vlozit vedle jeho jmena tlacitko Dotoceno, jakmile ho nekdo
/// stiskne, objevi se vedle jmena zelena fajfka").
///
/// Je to vlastnost DVOJICE projekt + herec, ne projektu: na audioknize byva
/// hercu vic a kazdy konci jindy. Podle toho se pak Peter rozhoduje, jestli
/// uz projekt prehodit do "Dotoceno/strihame".
///
/// Radek existuje = dotoceno. Odskrtnuti radek smaze, takze se nedrzi
/// historie prepinani sem a tam - v praxi je to preklep, ne udalost.
model HerecDotocen {
  id              String @id @default(cuid())
  caflouProjectId String

  userId String
  user   User   @relation("DotocenyHerec", fields: [userId], references: [id], onDelete: Cascade)

  dotocenoAt     DateTime @default(now())
  /// Kdo to odskrtl - at je v projektu videt, po kom se ptat.
  potvrdilUserId String?
  potvrdilJmeno  String?

  @@unique([caflouProjectId, userId])
  @@index([caflouProjectId])
}

/// Vzor zpravy klientovi pro jeden stav projektu (zadani 11. 9. 2026:
/// "udelame vzory a ja si je pak muzu textove jeste treba upravit,
/// pracoval bych i s promennymi").
///
/// Do te doby byly texty napsane v kodu (CO_SE_POSILA v lib/notifikaceFirmy).
/// Menit zneni zpravy klientovi kvuli preklepu znamenalo nasazovat portal
/// znovu - a psat to ma stejne produkce, ne programator.
///
/// Radek existuje jen pro stav, ktery nekdo upravil. Co ulozene neni, se bere
/// z vychozich textu v lib/vzoryZprav.ts, takze "Obnovit vychozi" znamena
/// proste radek smazat.
model VzorZpravy {
  /// DRUH ZPRAVY (zadani 14. 9. 2026: „musime jeste vymyslet dva druhy
  /// notifikaci. Jeden druh je pro Audioknihy a druhy pro reklamy. U reklam
  /// bych to potreboval trosku jinak zformulovat").
  ///
  /// „AUDIOKNIHA" nebo „REKLAMA" - viz DruhNotifikace v lib/notifikaceFirmy.ts.
  /// Vychozi hodnota drzi uz napsane vzory tam, kde byly.
  druh String @default("AUDIOKNIHA")

  /// Nazev stavu projektu - viz stavySNotifikaci(druh).
  stav String

  /// Predmet mailu. Prazdne = vychozi.
  predmet String?
  /// Velky nadpis nad textem. Prazdne = zadny nadpis, jako do 11. 9. 2026.
  nadpis  String?
  /// Hlavni text. Prazdny radek oddeluje odstavce.
  text    String  @db.Text

  /// PRIDAT TLACITKO „Preposlechnout v AudioTaggeru"? (zadani 14. 9. 2026:
  /// „pridej moznost nejakym zaskrtavacim tlacitkem, kdy se bude posilat
  /// i moznost poslechnout v Audiotaggeru. Treba u Dokonceno - ke schvaleni
  /// by taky mela byt. Muze se nekdy stat, ze vsechny tracky posilame
  /// najednou.")
  ///
  /// Do te doby to bylo zadratovane na stav „prvni tracky". Prazdno (null)
  /// znamena „jak to chodilo doted" - viz vychoziVzor v lib/vzoryZprav.ts.
  audiotagger Boolean?

  upravilJmeno String?
  updatedAt    DateTime @updatedAt

  @@id([druh, stav])
}

/// ZAPNUTI / VYPNUTI AUTOMATICKE ZPRAVY (zadani 15. 9. 2026: „udelejme pro
/// tyhle maily a notifikace pak nekde administraci").
///
/// Radek existuje jen pro zpravu, u ktere nekdo prepnul vychozi stav.
/// Co tu neni, je ZAPNUTE - novou zpravu nema smysl nasazovat vypnutou.
model NastaveniOznameni {
  /// Klic zpravy - viz OZNAMENI v lib/oznameni.ts.
  klic String @id

  zapnuto   Boolean  @default(true)
  zmenilJmeno String?
  updatedAt DateTime @updatedAt
}

/// ODESLANY MESICNI PREHLED VYKAZU (zadani 15. 9. 2026: „jednou za mesic
/// prijde notifikace s prehledem vykazu za minuly mesic zvukari na mail.
/// Melo by to chodit vzdy 6. den v mesici za minuly").
///
/// Jeden radek na dvojici zvukar + mesic. Diky nemu muze uloha bezet
/// klidne vickrat - druhy mail uz neodejde.
model MesicniPrehledOdeslan {
  id String @id @default(cuid())

  userId String
  /// Mesic, ZA KTERY prehled je, ve tvaru „2026-08".
  mesic  String

  /// Na jakou adresu to slo - at je pozdeji dohledatelne kam.
  prijemce   String?
  odeslanoAt DateTime @default(now())

  @@unique([userId, mesic])
}

/// KDY A CO CHODI ZVUKARUM V MESICNIM PREHLEDU (zadani 21. 9. 2026: „abych
/// nekde mohl nastavit kdy jim to chodi a co"). Jediny radek s id „vychozi";
/// kdyz chybi, plati vychozi hodnoty (sesteho, vsechno).
model NastaveniPrehleduZvukaru {
  id          String   @id @default("vychozi")
  /// Den v mesici (1-28), kdy prehled za minuly mesic odejde.
  den         Int      @default(6)
  castky      Boolean  @default(true)
  druhy       Boolean  @default(true)
  projekty    Boolean  @default(true)
  bonusy      Boolean  @default(true)
  /// Vlastni vzkaz, ktery se vlozi do mailu nad odkaz na vykazy.
  poznamka    String?  @db.Text
  zmenilJmeno String?
  updatedAt   DateTime @updatedAt
}

/// PRODLEVA NOTIFIKACI PRI ZMENE STAVU (zadani 22. 9. 2026: „nastav jeste
/// z bezpecnostnich duvodu latenci v posilani notifikaci pri zmene stavu.
/// 10s. bylo by dobre, kdybych to pozdeji mohl nekde hromadne nastavit").
/// Zprava klientovi odchazi az po prodleve - kdyz se mezitim stav prehodi
/// jinam (preklep), neodejde. Jediny radek s id „vychozi"; kdyz chybi,
/// plati 10 s.
model NastaveniNotifikaci {
  id             String   @id @default("vychozi")
  prodlevaSekund Int      @default(10)
  zmenilJmeno    String?
  updatedAt      DateTime @updatedAt
}

/// STAV NAVRZENEHO BONUSU ZVUKARE (zadani 15. 9. 2026).
enum StavBonusu {
  NAVRZENO
  SCHVALENO
  ZAMITNUTO
}

/// BONUS ZVUKARE ZA AUDIOKNIHU (zadani 15. 9. 2026: „aby nam portal
/// automaticky navrhnul schvaleni bonusu pro zvukare u audioknih. Podminka
/// ziskani bonusu je ta, ze zvukar ma na audioknize ve strihu splneno alespon
/// 90 % v ramci celeho strihu").
///
/// Navrh vznika SAM ve chvili, kdy projekt prejde do stavu „Schvaleno -
/// k fakturaci". Castka i podil se ulozi tak, jak vysly TEHDY - pozdejsi
/// dopsany vykaz nebo zmena normostran uz schvalenym bonusem nehne, jinak by
/// se cislo, ktere nekdo odklikl, pod rukama menilo.
///
/// Jeden radek na dvojici projekt + zvukar: druhy navrh na tehoz cloveka
/// u tehoz projektu nema co rikat.
model BonusZvukare {
  id String @id @default(cuid())

  caflouProjectId String
  /// Nazev projektu textem - bonus zustane citelny i po prejmenovani.
  projectName     String?

  userId String
  user   User   @relation("BonusZvukare", fields: [userId], references: [id], onDelete: Cascade)

  /// Castka bonusu v celych Kc, z rozpoctu v okamziku navrzeni.
  castka Int

  /// Podil zvukare na strihu projektu v procentech (0-100) v okamziku navrzeni.
  podilProcent Int
  /// Odpracovane minuty strihu - jeho a celkove. Z nich podil vysel.
  minutZvukare Int
  minutCelkem  Int

  stav StavBonusu @default(NAVRZENO)

  /// Pridal ho clovek rucne (zadani 15. 9. 2026: „potrebuju, aby Peter mohl
  /// mit moznost pridat bonus rucne")? U takoveho bonusu podil na strihu nic
  /// neznamena - portal ho nepocital, jen ho doplnil podle vykazu, pokud
  /// nejake byly.
  rucne Boolean @default(false)

  navrzenoAt   DateTime  @default(now())
  rozhodnutoAt DateTime?
  /// Kdo bonus schvalil nebo zamitl.
  rozhodlId     String?
  rozhodlJmeno  String?
  /// Duvod zamitnuti, pripadne poznamka ke schvaleni.
  poznamka      String?

  @@unique([caflouProjectId, userId])
  @@index([stav])
  @@index([userId])
}

/// Polozkove naklady projektu (zadani 11. 9. 2026: „do te karty mi dej treba
/// polozkove menu naklady, tak napisu naklady na herce a tak dale").
///
/// U audioknihy si naklady portal spocita z normostran. U reklamy zadny takovy
/// vzorec neni, takze si je produkce napise sama - honorar herce, studio,
/// hudba. Castka je v CELYCH KORUNACH BEZ DPH, stejne jako zbytek rozpoctu.
model ProjektNaklad {
  id              String @id @default(cuid())
  caflouProjectId String

  nazev  String
  castka Int
  poradi Int @default(0)

  createdAt DateTime @default(now())

  @@index([caflouProjectId])
}

/// Kde clovek skoncil v preposlechu (zadani 11. 9. 2026: „aby si nejak
/// jednoduse pamatoval, kde se skoncilo v preposlechu, kdyz si chce dat clovek
/// pauzu").
///
/// Klic je PROJEKT + POSLUCHAC, ne jen projekt: nahravku posloucha vic lidi
/// naraz (zvukar, produkce, klient z odkazu) a cizi zalozka je horsi nez
/// zadna. Posluchac je bud ucet (u:<id>), nebo token z mailu (t:<token>) -
/// u nej jine jmeno nemame.
model PreposlechPozice {
  id              String @id @default(cuid())
  caflouProjectId String
  /// "u:<userId>" nebo "t:<token>".
  posluchac       String

  trackIndex Int
  localTime  Float

  /// Jmeno, aby se u nas interne poznalo, KDO posloucha. U odkazu z mailu
  /// jine jmeno nemame, tam je to "Klient".
  jmeno String?
  /// Hralo to pri poslednim zapisu? Spolu s updatedAt z toho vyjde
  /// "prave posloucha" - viz signalizace v AudioTaggeru.
  hraje Boolean @default(false)
  /// Strana PDF, na ktere byl pri poslednim zapisu (21. 9. 2026) - podle ni
  /// se doplni strana, kterou preskocil jednim otocenim o dve.
  strana Int?
  /// Kam az je ktera stopa poslechnuta (zadani 21. 9. 2026: „stopa by mela
  /// zustat probarvena na miste, kde to prerusim"): { "<poradi stopy>": podil
  /// 0-1 }. Drzi se nejdal dosazene misto; 1 = do konce.
  stopyDoKam Json?

  updatedAt DateTime @updatedAt

  @@unique([caflouProjectId, posluchac])
}

// ---------------------------------------------------------------------------
// BRUNO - asistent studia (zadani 12. 9. 2026: „pojdme pridat naseho firemniho
// otroka, ktery se jmenuje Bruno. Chci, aby delal ruzne veci, ale prvni ukol
// bude sbirat data z komunikaci internich a pamatovat si souvislosti.")
//
// Bruno cte kanaly projektu v chatu a vytahuje z nich udaje, ktere by jinak
// nikdo nikam nepsal. Neni to hledani vzorcu v textu - zpravu posuzuje model,
// takze pochopi „str33", „str.33" i holou „33" a pozna, kdy se ho nekdo ptá
// na neco jineho. Kdyz si neni jisty, ZEPTA SE V KANALU misto hadani.
// ---------------------------------------------------------------------------

/// Kam se u projektu doteklo natacení - strana ve scenari/PDF, kde se skoncilo.
///
/// Klic je PROJEKT + HEREC: kdyz se toci s vice herci, kazdy je jinde. Prazdny
/// herec znamena, ze projekt ma jedineho herce (nebo jeste neni jasne kdo -
/// pak to Bruno doresi dotazem v kanalu).
model BrunoNatoceno {
  id              String   @id @default(cuid())
  caflouProjectId String
  userId          String?
  user            User?    @relation("BrunoNatocenoHerec", fields: [userId], references: [id], onDelete: Cascade)

  strana          Int
  /// Zprava, ze ktere to Bruno vycetl - at je dohledatelne, odkud to vzal.
  zdrojMessageId  String?
  /// Kdo tu zpravu napsal (typicky zvukar).
  zapsalUserId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Kazdy zapis je vlastni radek (zadani 13. 9. 2026: „v detailu bych to
  // delal jako zaznamy: Datum a strana"). Drive tu byl @@unique na dvojici
  // projekt+herec a novy zapis ten stary prepsal - bylo videt jen kde jsme
  // ted, ne jak se tam doslo.
  @@index([caflouProjectId])
  @@index([caflouProjectId, userId, createdAt])
}

/// Co si Bruno zapamatoval, aby se priste rozhodoval lip.
///
/// Tohle je ta „pamet souvislosti": ne surova data, ale vety typu „Martin pise
/// strany bez slova strana" nebo „na tomhle projektu toci Petr utery, Klara
/// ctvrtky". Pred kazdym rozhodnutim je Bruno dostane zpatky.
model BrunoPamet {
  id              String   @id @default(cuid())
  /// Prazdne = poznamka plati vsude; jinak jen u toho projektu.
  caflouProjectId String?
  poznamka        String
  createdAt       DateTime @default(now())

  @@index([caflouProjectId, createdAt])
}

/// Příručka pro Bruna - jak to u nás chodí (zadání 16. 9. 2026: „nedokázali
/// bychom Bruna naučit vnímat i naši workflow, aby znal, jak funguje portál
/// a naše procesy?").
///
/// Rozdíl proti BrunoPamet: tohle píšou LIDI v administraci a Bruno to jen
/// čte. Patří sem věci, které si nemá odvozovat z chatu - co který stav
/// projektu znamená, kdo co dělá, co u nás znamená „dotáčka" nebo
/// „přeposlech". Pamět si naopak plní sám a jsou v ní zvyklosti, které
/// z chatu vypozoroval.
///
/// Jeden řádek, id "default" - stejně jako BudgetSettings. Když řádek není,
/// použije se výchozí text z lib/brunoPrirucka.ts.
model BrunoPrirucka {
  id        String   @id @default("default")
  text      String   @db.Text
  updatedAt DateTime @updatedAt
  /// Kdo příručku naposledy uložil - jméno, ne vazba; je to jen popisek.
  updatedBy String?
}

/// Kdo prave pise v konverzaci (zadani 12. 9. 2026: „aby bylo videt, kdyz
/// s nekym chatujes, ze na te druhe strane ten clovek pise").
///
/// Jeden radek na dvojici konverzace + clovek, ktery se jen prepisuje - kdo
/// pise, hlasi se kazdych par vterin. Za „pise" se povazuje radek mladsi nez
/// nekolik vterin; nic se nemaze a nic se nehlida, stary zaznam proste
/// prestane platit sam od sebe.
model ChatPise {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  updatedAt      DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId, updatedAt])
}

/// Historie preposlechu (zadani 12. 9. 2026: „mozna mohlo byt dobre mit
/// nejakou historii, log by se odkryl treba na prave strane").
///
/// Je to zaznam o tom, co se s nahravkou dělo: kdo odkaz otevrel, kdo pridal
/// nebo opravil poznamku, kdo odskrtl preposlechnuto. Samotne poznamky zijí
/// v PreposlechChyba - tohle je stopa, ktera zustane, i kdyz se poznamka
/// smaze.
model PreposlechUdalost {
  id              String   @id @default(cuid())
  caflouProjectId String

  /// OTEVRENO / PRIDANA / UPRAVENA / SMAZANA / PREPOSLECHNUTO / ZNOVU
  typ             String
  /// Veta, jak se to ukaze cloveku.
  popis           String   @db.Text
  /// Jmeno textem - zaznam zustane citelny, i kdyz ucet pozdeji zmizi.
  kdo             String?

  /// Ktere poznamky se krok tykal (zadani 12. 9. 2026: „kdyz to bude nejaky
  /// krok v editaci, tak bude moznost se do toho bodu vratit").
  chybaId         String?
  /// Jak poznamka vypadala PRED timhle krokem. U pridani je prazdny -
  /// predtim nebylo co vracet. Z nej se krok vraci zpatky.
  snimek          Json?
  /// Uz byl tenhle krok vracen? Vracet ho podruhe nema smysl.
  vracenoAt       DateTime?

  createdAt       DateTime @default(now())

  @@index([caflouProjectId, createdAt])
}


// ---------------------------------------------------------------------------
// ZPETNA VAZBA K PORTALU (zadani 15. 9. 2026: „potreboval bych vymyslet
// nejakou zpetnou vazbu k portalu. Me by se objevoval nejaky seznam - to do
// list, roztrideny od kazdeho uzivatele a vsechny pripominky bych videl jen
// ja ve svem profilu. Uzivatele by to psali jako jednotlive polozky
// s moznosti, ze by mohli prilozit i printscreeny. Ja bych si to pak jen
// odskrtaval a jim by to mizelo.")
// ---------------------------------------------------------------------------

enum StavPripominky {
  NOVA
  HOTOVA
}

/// Jedna pripominka k portalu. Pise ji kdokoliv, cte je jen Zuzo-labuzo.
model PripominkaPortalu {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PripominkyPortalu", fields: [userId], references: [id], onDelete: Cascade)

  text String @db.Text

  /// Kde v portalu to bylo - adresa stranky, ze ktere pripominka odesla.
  /// Sami od sebe to lidi nenapisou a bez toho se pulka pripominek nedohleda.
  odkud String?

  stav StavPripominky @default(NOVA)

  /// Odskrtnuti: kdy, kdo a pripadna poznamka („opraveno", „nedela se").
  hotovoAt     DateTime?
  hotovoById   String?
  hotovoJmeno  String?
  poznamka     String?

  /// Podobna pripominka, ke ktere se tahle pripojila. Duplicit je u zpetne
  /// vazby vic nez cehokoliv jineho - portal na ne upozorni pri psani a kdo
  /// chce, pripoji se k existujici misto zakladani dalsi.
  podobnaId String?

  prilohy PripominkaPriloha[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([stav])
  @@index([podobnaId])
}

/// Printscreen k pripomince. Stejne uloziste jako prilohy vydaju - kdyz neni
/// nastavene S3, ulozi se obrazek jako data URL primo do databaze.
model PripominkaPriloha {
  id           String            @id @default(cuid())
  pripominkaId String
  pripominka   PripominkaPortalu @relation(fields: [pripominkaId], references: [id], onDelete: Cascade)

  url   String @db.Text
  nazev String

  createdAt DateTime @default(now())

  @@index([pripominkaId])
}

/// Koho se zadost o udaje tyka.
enum PozvankaDruh {
  HEREC
  FIRMA
}

/// Kde zadost o udaje stoji.
enum PozvankaStav {
  /// Odkaz je vyrobeny (a nejspis odeslany), ceka se na vyplneni.
  CEKA
  /// Clovek formular odeslal, ale menil uz vyplnene udaje - ceka na odkliknuti.
  VYPLNENA
  /// Udaje jsou v portalu.
  HOTOVA
  /// Zrusena rucne, nebo uz neplati.
  ZRUSENA
}

/// ZADOST O UDAJE ODKAZEM (zadani 16. 9. 2026: „potrebuji vymyslet nejaky
/// system, kdy budeme hercum nebo firmam - kazdy zvlast - posilat odkaz, na
/// kterem bude formular, kde vyplni sve udaje").
///
/// Odkaz je otevreny, jako podpis smlouvy: clovek se nikam neprihlasuje, jen
/// klikne a vyplni. Token je jedina vec, ktera zadost identifikuje, takze je
/// dlouhy a plati omezenou dobu.
///
/// CO SE VYPLNI, SE DRZI V `data` I POTOM, co je to v portale zapsane -
/// je to doklad o tom, co clovek sam napsal a kdy. Portal se podle nej da
/// kdykoli zpetne srovnat.
model PozvankaUdaju {
  id    String       @id @default(cuid())
  token String       @unique
  druh  PozvankaDruh
  stav  PozvankaStav @default(CEKA)

  /// Koho se to tyka, kdyz uz v portalu je. Kdyz je oboji prazdne, zaklada se
  /// novy zaznam z toho, co clovek vyplni.
  userId    String?
  user      User?    @relation("PozvankaUdajuKomu", fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation("PozvankaUdajuFirma", fields: [companyId], references: [id], onDelete: SetNull)

  /// Pro koho je odkaz urceny, nez z nej vznikne zaznam - at je v seznamu videt,
  /// komu se psalo.
  jmeno String?
  email String?

  platiDo DateTime

  vytvorilId String?
  vytvoril   User?   @relation("PozvankaUdajuVytvoril", fields: [vytvorilId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  odeslanoAt   DateTime?
  vyplnenoAt   DateTime?
  zpracovanoAt DateTime?

  /// Co clovek vyplnil - cely formular tak, jak ho odeslal.
  data Json?

  /// Poznamka od nas (proc se to posilalo), i to, co pripsal on.
  poznamka  String?
  vzkazOdNej String? @db.Text

  @@index([stav])
  @@index([userId])
  @@index([companyId])
}

/// NÁVODY V PORTÁLU (zadání 16. 9. 2026: „přemýšlím, že by tyhle manuály mohly
/// být někde dostupné v portálu, aby se k nim všichni dostali. Udělejme nějakou
/// přehlednou sekci a tam budeme vše postupně přidávat. I s nějakým fulltext
/// hledáním").
///
/// Návody si portál drží sám, ne jako soubory v repozitáři: píše je a opravuje
/// člověk, ne programátor, a hledá se v nich za běhu.
///
/// `hledaci` je text bez diakritiky a malými písmeny (název + perex + obsah).
/// Díky němu najde „nahravka" i „nahrávka" - Postgres by jinak potřeboval
/// rozšíření unaccent, které na Supabase zapínat nechceme kvůli jednomu poli.
model Navod {
  id     String @id @default(cuid())
  /// Adresa návodu: /napoveda/<slug>.
  slug   String @unique
  nazev  String
  /// Jedna věta do seznamu - o čem návod je.
  perex  String?
  /// Do které skupiny v přehledu patří („Herci", „Doklady"…).
  kategorie String @default("Ostatní")
  /// Text návodu v Markdownu.
  obsah  String @db.Text
  /// Připravený text pro hledání - viz poznámka u modelu.
  hledaci String @db.Text

  /// Pořadí uvnitř kategorie; menší číslo je výš.
  poradi     Int     @default(100)
  /// Rozepsaný návod vidí jen Zuzo-labuzo.
  zverejneno Boolean @default(true)
  /// Komu se návod ukáže. Prázdné = všem přihlášeným.
  proRole    String[] @default([])

  autorId String?
  autor   User?   @relation("NavodAutor", fields: [autorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kategorie, poradi])
  @@index([zverejneno])
}

// ===========================================================================
// BANKA (zadani 17. 9. 2026: „potrebuju, at se ta banka paruje sama")
//
// Air Bank ma vlastni PSD2 API jen pro registrovane TPP s eIDAS certifikatem,
// takze se na nej primo napojit nejde. Chodi se pres GoCardless Bank Account
// Data (drive Nordigen), ktery je pro tenhle rozsah zdarma: clovek jednou
// odklikne souhlas v internetovem bankovnictvi a portal si pak sam stahuje
// pohyby. Souhlas ma omezenou platnost (~90 dnu) a obnovuje se stejnym
// kliknutim - proto se u napojeni drzi datum, do kdy plati.
// ===========================================================================

/// Napojeny bankovni ucet. Jeden radek = jeden ucet u GoCardless.
model BankConnection {
  id String @id @default(cuid())

  /// Kod banky u GoCardless, napr. AIRBANK_AIRACZPP.
  institutionId   String
  institutionName String

  /// Id souhlasu (requisition) a dohody (agreement) u GoCardless.
  requisitionId String  @unique
  agreementId   String?

  /// Id uctu u GoCardless - teprve po odkliknuti souhlasu.
  accountId String?
  iban      String?
  /// Jak se ucet jmenuje v portalu („Air Bank CZK").
  label String?

  /// Ke ktere nasi firme ucet patri - kvuli parovani faktur.
  issuerCompanyId String?
  issuer          IssuerCompany? @relation(fields: [issuerCompanyId], references: [id], onDelete: SetNull)

  /// CEKA (souhlas jeste neodkliknut) | AKTIVNI | VYPRSELO | CHYBA
  stav             String    @default("CEKA")
  consentExpiresAt DateTime?

  lastSyncAt    DateTime?
  lastSyncError String?

  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stav])
}

/// Jeden pohyb na uctu. Drzi se i to, co se nesparovalo - jinak by clovek
/// nemel kde overit, proc faktura zustala neuhrazena.
model BankTransaction {
  id           String         @id @default(cuid())
  connectionId String
  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Id transakce od banky - podle nej se pozna, ze uz ji portal zna.
  externalId String

  bookedAt DateTime
  /// Kladna castka = prichozi platba. V nejmensi jednotce meny.
  amountMinor Int
  currency    Currency @default(CZK)

  variableSymbol      String?
  counterpartyName    String?
  counterpartyAccount String?
  /// Zprava pro prijemce, poznamka, cokoliv textoveho od banky.
  reference String?

  /// Sparovana faktura.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// NOVA | AUTO (sparovano samo) | NAVRH (ceka na potvrzeni) | RUCNE
  /// | IGNOROVANA (clovek rekl, ze k zadne fakture nepatri)
  stav String @default("NOVA")
  /// Kdyz je stav NAVRH: ke ktere fakture a proc.
  navrhInvoiceId String?
  navrhDuvod     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([stav, bookedAt])
  @@index([invoiceId])
}

/// Druh licence u projektu (zadani 18. 9. 2026). Ciselnik jako typy projektu:
/// nazvy si tym pridava sam v Cenicich, proto to nejsou hodnoty v kodu.
model DruhLicence {
  id     String  @id @default(cuid())
  /// „Online", „TV", „Radio"...
  nazev  String  @unique
  /// Klic ikony z lib/ikonyTypu.tsx; prazdne = bez ikony.
  ikona  String?
  poradi Int     @default(100)
  /// Vyrazeny druh se uz nenabizi, ale u starych projektu zustava.
  active Boolean @default(true)

  projekty ProjectMeta[] @relation("ProjektLicence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, poradi])
}


/// Druh nepritomnosti v kalendari dovolenych (zadani 19. 9. 2026).
enum DruhNepritomnosti {
  DOVOLENA    // Dovolena
  MIMO_STUDIO // Je mimo studio - pracuje jinde, jednani, sluzebni cesta
  JINE        // Cokoliv jineho, co se nehodi do kolonek vyse
}

/// KALENDAR DOVOLENYCH A NEPRITOMNOSTI (zadani 19. 9. 2026: „potrebuji jeden
/// kalendar, do ktereho si budou lidi psat dovolene a kdy jsou mimo studio.
/// Tam neni treba projekt, jen moznost celodenni udalosti").
///
/// SCHVALNE ZVLAST OD StudioBlock. Blokace patri studiu - rika, kdy se v nem
/// netoci. Dovolena patri CLOVEKU a studia se netyka: kdyz je zvukar na
/// dovolene, studio je volne, jen on ne. Kdyby to byla blokace jednoho
/// studia, zmizela by z kalendare ostatnich studii a v nabidkach terminu by
/// se chovala jako obsazene studio.
///
/// CELODENNI je vychozi. `start` je pulnoc prvniho dne a `end` pulnoc po
/// poslednim dni (v case Prahy) - stejne jako u ostatnich udalosti, takze se
/// prekryvy hledaji jednim dotazem. U neceledenni je to obycejny cas od-do.
model Nepritomnost {
  id       String            @id @default(cuid())
  /// Kdo je pryc. Kdyz ucet zanikne, zaznam zustane s otiskem jmena.
  userId   String?
  user     User?             @relation("NepritomnostKdo", fields: [userId], references: [id], onDelete: SetNull)
  jmeno    String
  druh     DruhNepritomnosti @default(DOVOLENA)
  celyDen  Boolean           @default(true)
  start    DateTime
  end      DateTime
  poznamka String?

  /// Kdo to zapsal - produkce zapisuje i za ostatni.
  zapsalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([start, end])
  @@index([userId])
}

/// NÁVRH VÝKAZU Z KALENDÁŘE (zadání 20. 9. 2026: „nabídnutí výkazu zvukařům
/// po skončené frekvenci… nabídnout by to mělo 5 min. před skončením").
///
/// Jedna skončená práce v kalendáři (frekvence z nabídky nebo ručně zapsané
/// natáčení, střih, casting) = jeden návrh pro zvukaře, který u ní je. Návrh
/// si drží stav, aby se po zapsání nebo odmítnutí nenabízel znovu, a `zdroj`
/// říká, ze které události vznikl (slot:<id> / blok:<id>).
model NavrhVykazu {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// „slot:<id>" nebo „blok:<id>" - podle toho se pozná, že návrh už existuje.
  zdroj String

  start DateTime
  end   DateTime

  workType        WorkType
  caflouProjectId String?
  projectName     String?
  /// Jen pro popis v nabídce - studio a herec, ať zvukař pozná, o co šlo.
  studioName String?
  actorName  String?

  stav      StavNavrhu @default(CEKA)
  /// Výkaz, který z návrhu vznikl - kdyby se ho někdo ptal zpětně.
  timesheetEntryId String?
  /// Kdy se o něm zvukař dozvěděl (zvoneček + push). Prázdné = ještě ne.
  oznamenoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, zdroj])
  @@index([userId, stav])
}

enum StavNavrhu {
  CEKA      // čeká na zvukaře
  ZAPSANO   // zvukař z něj udělal výkaz
  ODMITNUTO // zvukař řekl, že se vykazovat nemá
}

// ===========================================================================
// PORADY (zadani 21. 9. 2026: „pojdme ted udelat jeste jeden kalendar Porady,
// ktery bude zlutou barvou. Tam by bylo super, kdyby ho videli jen lidi
// z tymu, kteri si vytvori skupinu, jako je to v chatu ... Melo by tam jit
// i nastavit opakovani udalosti a pridat link na videohovor").
//
// Porada neni vazana na studio - je to schuzka lidi. VIDI JI JEN UCASTNICI
// (ani spravce kalendare ne, kdyz na ni neni pozvany). Opakovani se uklada
// jako pravidlo, ne jako stovky radku: vyskyty se dopocitavaji pro zobrazeny
// rozsah (lib/porady.ts). Jednotlivy vyskyt jde vynechat.
// ===========================================================================

enum OpakovaniPorady {
  NE
  DENNE
  PRACOVNI_DNY
  TYDNE
  KAZDE_DVA_TYDNY
  MESICNE
}

model Porada {
  id          String          @id @default(cuid())
  nazev       String
  /// Prvni vyskyt - zacatek a konec. Delka se u opakovani drzi stejna.
  start       DateTime
  end         DateTime
  opakovani   OpakovaniPorady @default(NE)
  /// Posledni den, kdy se jeste opakuje (vcetne). Prazdne = porad dal.
  opakovatDo  DateTime?
  /// Vynechane vyskyty - dny YYYY-MM-DD (v Praze), smazane jednotlive.
  vynechano   String[]        @default([])
  /// Odkaz na videohovor (Meet, Zoom, Teams…).
  odkazVideo  String?
  poznamka    String?
  zalozilId   String?
  ucastnici   PoradaUcastnik[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([start])
}

model PoradaUcastnik {
  poradaId String
  porada   Porada @relation(fields: [poradaId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([poradaId, userId])
  @@index([userId])
}

/// ZÁLOHA TEXTŮ (zadání 22. 9. 2026: „když se ve složce projektu vytvoří PDF
/// s _RE, musí se duplikovat a udělat záloha textu do složky… zároveň musíme
/// hlídat duplicity"). Jeden řádek = jedna verze souboru (id + obsah), která
/// už v zálohové složce je - podle toho se nekopíruje dvakrát.
model ZalohaTextu {
  id        String   @id @default(cuid())
  zdrojId   String
  /// Otisk obsahu z Disku - stejný soubor se stejným obsahem se nezálohuje znovu.
  md5       String
  kopieId   String?
  nazev     String
  /// Proč kopie nevznikla ("duplicita" = stejný obsah už v záloze je).
  poznamka  String?
  createdAt DateTime @default(now())

  @@unique([zdrojId, md5])
  @@index([md5])
}

/// LICENČNÍ LIST (zadání 22. 9. 2026: „u reklam budeme klientovi vystavovat
/// licenční listy, netýká se to rádiových spotů. Jde o vymezení licence pro
/// daného herce"). Jeden řádek = jeden vystavený dokument pro jednoho
/// interpreta. Hodnoty jsou uložené tak, jak jsou vytištěné v PDF.
model LicencniList {
  id              String   @id @default(cuid())
  caflouProjectId String
  projectName     String
  companyId       String?
  /// Herec z projektu, pokud je to účet v portálu (jinak jen jméno níže).
  actorUserId     String?

  fileName String
  /// PDF v úložišti (nebo data URL, když úložiště není) - jako u Rodného listu.
  url      String  @db.Text
  driveFileId String?
  driveUrl    String?
  driveError  String?

  nazevSpotu   String
  klient       String
  objednatel   String
  dodavatel    String
  interpret    String
  typDila      String
  uzemi        String
  media        String
  delkaLicence String
  typLicence   String
  datumVyroby  DateTime
  podminky     String   @db.Text
  misto        String
  podepisuje   String

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([caflouProjectId])
}

/// INSTAGRAM NA TABULÍCH (zadání 22. 9. 2026: „můžeme propojit tu tabuli ve
/// studiu s účtem na Instagramu? Že by se tam promítaly i příběhy v nějakém
/// okně"). Jeden připojený účet pro celé studio. Token vydá Instagram po
/// přihlášení (Instagram API s přihlášením přes Instagram), platí 60 dní
/// a portál si ho sám prodlužuje. Příběhy se drží v mezipaměti ~10 minut.
model InstagramUcet {
  id        String    @id @default("hlavni")
  igUserId  String
  username  String?
  token     String    @db.Text
  tokenDo   DateTime
  /// Poslední stažené příběhy / příspěvky (JSON pole) a kdy.
  cache     Json?
  cacheAt   DateTime?
  chyba     String?
  updatedAt DateTime  @updatedAt
}

/// WIKIPEDIE - KONCEPT A HLIDANI CLANKU (zadani 22. 9. 2026: „chtel bych u
/// sebe udelat nejaky modul na wikipedii a editaci me osoby. Ucet na wiki
/// nemam" → „Koncept + hlidani", clanek bude novy).
///
/// Portal na Wikipedii NIC neuklada - clanek se tu pise a ladi (wikitext
/// s nahledem), na Wikipedii ho vlozi clovek svym uctem. Kdyz je vyplneny
/// `sledovanyNazev`, portal kazdou hodinu kontroluje zivy clanek a o cizi
/// uprave da vedet zvonkem. Jeden clanek na ucet.
model WikiClanek {
  id               String    @id @default(cuid())
  userId           String    @unique
  jazyk            String    @default("cs")
  /// Navrzeny nazev clanku (napr. „Ondřej Černý (režisér)").
  nazev            String
  wikitext         String    @db.Text
  /// Vyplneny formular „Udaje", ze ktereho se wikitext sklada (22. 9. 2026).
  udaje            Json?
  /// Nazev zive stranky na Wikipedii, ktera se hlida (az bude vlozena).
  sledovanyNazev   String?
  /// Osobni pristupovy token (OAuth 2.0 „owner-only" na meta.wikimedia.org),
  /// kterym portal odesila upravy za uzivatele (zadani 22. 9. 2026: „chci to
  /// rovnou odesilat z portalu"). Nikdy se nevraci do prohlizece.
  token            String?
  /// Kam se odesila - vychozi je vlastni piskoviste.
  cilStranka       String?
  posledniRevize   Int?
  posledniKontrola DateTime?
  chybaKontroly    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Chat nad clankem (zadani 22. 9. 2026: „vytvoril bych tam nejaky chat,
/// se kterym budu vzpominat na minulost a veci, ktere by tam na wiki mohly
/// byt a on to bude formulovat a vkladat"). Historie rozhovoru u konceptu.
model WikiZprava {
  id        String   @id @default(cuid())
  clanekId  String
  /// „ja" = uzivatel, „bot" = pomocnik.
  role      String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([clanekId, createdAt])
}

/// Ulozene verze konceptu - at jde vratit starsi text.
model WikiVerze {
  id        String   @id @default(cuid())
  clanekId  String
  wikitext  String   @db.Text
  autor     String?
  createdAt DateTime @default(now())

  @@index([clanekId, createdAt])
}
